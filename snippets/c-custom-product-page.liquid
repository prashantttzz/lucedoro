      { name: 'Steel Fade', value: 'steel-fade.png', image: "{{ 'steel-fade.png' | asset_url }}" }
    ];

    let selectedType = null;
    let selectedColor = null;
    let selectedColorType = null; // 'solid' or 'gradient'
    let rxFile = null;

    // Panel flow per lens type — panel numbers map to c-pdp-step-N divs
    function getStepsFlow(typeId) {
      if (typeId === 'sig-tints') return [1, 3, 4];
      if (typeId === 'sig-tints-rx') return [1, 2, 3, 4];
      if (typeId === 'digital-blue') return [1, 4];
      if (typeId === 'optical-clear') return [1, 2, 4];
      return [1, 4];
    }

    // Frame select -> tint -> summary. Matches getStepsFlow('sig-tints').
    const DEFAULT_FLOW = [1, 3, 4];

    let flow = DEFAULT_FLOW.slice();
    let flowIndex = 0;

    window.pdpSelectVariant = function(el, vId, imgSrc) {
      selectedVariantId = vId;
      selectedFrameColorName = el.querySelector('span') ? el.querySelector('span').textContent : selectedFrameColorName;
      document.querySelectorAll('.c-pdp-frame-swatch').forEach(s => s.classList.remove('is-selected'));
      el.classList.add('is-selected');

      if (imgSrc) {
        document.getElementById('c-pdp-main-image').src = imgSrc;
      }
    };

    window.pdpScrollGallery = function(direction) {
      const wrap = document.getElementById('c-pdp-gallery-wrap');
      if (!wrap) return;
      const scrollAmount = wrap.clientWidth;
      wrap.scrollBy({ left: direction * scrollAmount, behavior: 'smooth' });
    };

    const galleryWrap = document.getElementById('c-pdp-gallery-wrap');
    if (galleryWrap) {
      galleryWrap.addEventListener('scroll', () => {
        const index = Math.round(galleryWrap.scrollLeft / galleryWrap.clientWidth);
        const dots = document.querySelectorAll('.c-pdp-nav-dot');
        dots.forEach((dot, i) => {
          dot.classList.toggle('is-active', i === index);
        });
      });
    }

    window.pdpStartCustomizing = function() {
      document.getElementById('c-pdp-overview').style.display = 'none';
      document.getElementById('c-pdp-header').style.display = 'block';
      // Provisional flow: the real length is only known once a lens type is
      // picked on step 1. Seed the common 3-step path so the indicator reads
      // "step 1 of 3" rather than "step 1 of 1".
      flow = DEFAULT_FLOW.slice();
      flowIndex = 0;
      pdpShowPanel(1);
    };

    window.pdpShowOverview = function() {
      document.getElementById('c-pdp-overview').style.display = 'block';
      document.getElementById('c-pdp-header').style.display = 'none';
      [1, 2, 3, 4].forEach(n => document.getElementById(`c-pdp-step-${n}`).style.display = 'none');
    };

    function pdpShowPanel(panel) {
      [1, 2, 3, 4].forEach(n => document.getElementById(`c-pdp-step-${n}`).style.display = n === panel ? 'block' : 'none');

      document.getElementById('c-pdp-step-label').textContent = `Step ${flowIndex + 1} of ${flow.length}`;

      // Segmented progress: one bar per step in the current flow, so the
      // remaining work is legible at a glance rather than inferred from a
      // percentage width.
      const track = document.getElementById('c-pdp-progress-track');
      if (track) {
        if (track.children.length !== flow.length) {
          track.innerHTML = '';
          for (let i = 0; i < flow.length; i += 1) {
            track.appendChild(document.createElement('span'));
          }
        }
        Array.from(track.children).forEach((seg, i) => {
          seg.className = i <= flowIndex ? 'is-filled' : '';
        });
      }

      if (panel === 3 && selectedColorType) {
        window.pdpSwitchTintTab(selectedColorType);
      }

      if (panel === 4) {
        updateSummary();
      }
    }

    // Advance to the next panel in the current flow
    window.pdpNextStep = function() {
      if (flowIndex >= flow.length - 1) return;
      flowIndex += 1;
      pdpShowPanel(flow[flowIndex]);
    };

    // Go back one panel in the current flow, or to product overview from the first panel
    window.pdpPrevStep = function() {
      if (flowIndex <= 0) {
        pdpShowOverview();
        return;
      }
      flowIndex -= 1;
      pdpShowPanel(flow[flowIndex]);
    };

    window.pdpSwitchTintTab = function(tint) {
      document.querySelectorAll('.c-pdp-tint-tab').forEach(tab => {
        tab.classList.toggle('is-active', tab.dataset.tint === tint);
      });
      document.getElementById('c-pdp-color-grid-solid').style.display = tint === 'solid' ? 'grid' : 'none';
      document.getElementById('c-pdp-color-grid-gradient').style.display = tint === 'gradient' ? 'grid' : 'none';
    };

    function renderTypes() {
      const container = document.getElementById('c-pdp-type-list');
      if (!container) return;
      container.innerHTML = '';

      lensTypes.forEach(t => {
        const card = document.createElement('div');
        card.className = 'c-pdp-type-card' + (selectedType && selectedType.id === t.id ? ' is-selected' : '');
        card.setAttribute('role', 'radio');
        card.setAttribute('tabindex', '0');
        card.setAttribute('aria-checked', selectedType && selectedType.id === t.id ? 'true' : 'false');
        card.innerHTML = `
          <div class="c-pdp-type-info">
            <div class="c-pdp-type-title">${t.title}</div>
            <div class="c-pdp-type-desc">${t.desc}</div>
          </div>
          <div class="c-pdp-type-price">+ AED ${t.price}</div>
        `;
        card.onclick = () => {
          selectedType = t;
          if (t.id !== 'sig-tints' && t.id !== 'sig-tints-rx') {
            selectedColor = null;
            selectedColorType = null;
          }
          renderTypes();
          flow = getStepsFlow(t.id);
          flowIndex = 0;
          window.pdpNextStep();
        };
        card.onkeydown = (e) => {
          if (e.key === 'Enter' || e.key === ' ') {
            e.preventDefault();
            card.onclick();
          }
        };
        container.appendChild(card);
      });
    }

    function renderColorGrid(containerId, colors, type) {
      const container = document.getElementById(containerId);
      if (!container) return;
      container.innerHTML = '';

      colors.forEach(c => {
        const item = document.createElement('div');
        item.className = 'c-pdp-color-item' + (selectedColor && selectedColor.name === c.name ? ' is-selected' : '');
        item.innerHTML = `
          <div class="c-pdp-color-left">
            <span class="c-pdp-color-dot" style="background: url('${c.image}') center/cover no-repeat;"></span>
            <div class="c-pdp-color-info">
              <span class="c-pdp-color-title">${c.name}</span>
            </div>
          </div>
          <div class="c-pdp-color-radio"></div>
        `;
        item.onclick = () => {
          selectedColor = c;
          selectedColorType = type;
          renderColorGrid('c-pdp-color-grid-solid', solidColors, 'solid');
          renderColorGrid('c-pdp-color-grid-gradient', gradientColors, 'gradient');
          window.pdpNextStep();
        };
        container.appendChild(item);
      });
    }

    // ------------------- PRESCRIPTION UPLOAD -------------------
    const rxInput = document.getElementById('c-pdp-rx-file-input');
    const rxZone = document.getElementById('c-pdp-upload-zone');

    if (rxInput && rxZone) {
      const VALID_TYPES = ['image/jpeg', 'image/png', 'application/pdf'];
      const MAX_BYTES = 10 * 1024 * 1024;

      const errorEl = document.getElementById('c-pdp-upload-error');
      const successEl = document.getElementById('c-pdp-upload-success');
      const continueBtn = document.getElementById('c-pdp-rx-continue-btn');

      function formatSize(bytes) {
        if (bytes < 1024) return bytes + ' B';
        if (bytes < 1024 * 1024) return (bytes / 1024).toFixed(0) + ' KB';
        return (bytes / (1024 * 1024)).toFixed(1) + ' MB';
      }

      function showError(message) {
        rxFile = null;
        errorEl.textContent = message;
        errorEl.style.display = 'flex';
        successEl.style.display = 'none';
        rxZone.style.display = 'flex';
        continueBtn.style.display = 'none';
      }

      function clearFile() {
        rxFile = null;
        rxInput.value = '';
        errorEl.style.display = 'none';
        successEl.style.display = 'none';
        rxZone.style.display = 'flex';
        continueBtn.style.display = 'none';
      }

      function acceptFile(file) {
        if (!file) return;

        if (!VALID_TYPES.includes(file.type)) {
          showError('That file type isn’t supported. Please upload a JPG, PNG, or PDF.');
          return;
        }

        if (file.size > MAX_BYTES) {
          showError('That file is ' + formatSize(file.size) + '. Please upload a file under 10 MB.');
          return;
        }

        rxFile = file;
        errorEl.style.display = 'none';
        rxZone.style.display = 'none';
        successEl.style.display = 'flex';
        continueBtn.style.display = 'block';
        document.getElementById('c-pdp-uploaded-filename').textContent = file.name;
        document.getElementById('c-pdp-uploaded-meta').textContent =
          formatSize(file.size) + ' · Uploaded';
      }

      rxInput.addEventListener('change', (e) => acceptFile(e.target.files[0]));

      rxZone.addEventListener('click', () => rxInput.click());
      rxZone.addEventListener('keydown', (e) => {
        if (e.key === 'Enter' || e.key === ' ') {
          e.preventDefault();
          rxInput.click();
        }
      });

      // The copy invites dragging, so wire it up. dragover must be cancelled or
      // the browser navigates to the dropped file instead of firing `drop`.
      ['dragenter', 'dragover'].forEach((evt) => {
        rxZone.addEventListener(evt, (e) => {
          e.preventDefault();
          rxZone.classList.add('is-dragover');
        });
      });

      ['dragleave', 'dragend'].forEach((evt) => {
        rxZone.addEventListener(evt, (e) => {
          // Ignore bubbling from children, or the highlight flickers.
          if (evt === 'dragleave' && rxZone.contains(e.relatedTarget)) return;
          rxZone.classList.remove('is-dragover');
        });
      });

      rxZone.addEventListener('drop', (e) => {
        e.preventDefault();
        rxZone.classList.remove('is-dragover');
        acceptFile(e.dataTransfer.files && e.dataTransfer.files[0]);
      });

      document.getElementById('c-pdp-upload-replace-btn').addEventListener('click', (e) => {
        e.stopPropagation();
        rxInput.click();
      });

      document.getElementById('c-pdp-upload-remove-btn').addEventListener('click', (e) => {
        e.stopPropagation();
        clearFile();
      });
    }

    function updateSummary() {
      document.getElementById('c-pdp-summary-frame-color').textContent = selectedFrameColorName.toLowerCase();
      document.getElementById('c-pdp-summary-type').textContent = selectedType ? selectedType.title.toLowerCase() : 'n/a';
      document.getElementById('c-pdp-summary-finish').textContent = selectedColorType ? (selectedColorType === 'solid' ? 'solid tint' : 'gradient tint') : 'n/a';
      document.getElementById('c-pdp-summary-color').textContent = selectedColor ? selectedColor.name.toLowerCase() : 'n/a';
      document.getElementById('c-pdp-summary-rx').textContent = rxFile ? 'yes' : 'no';

      const lensPrice = selectedType ? selectedType.price : 0;
      const total = basePrice + lensPrice;
      document.getElementById('c-pdp-summary-frame-price').textContent = 'AED ' + basePrice.toFixed(2);
      document.getElementById('c-pdp-summary-lens-price').textContent = '+ AED ' + lensPrice;
      document.getElementById('c-pdp-summary-price').textContent = 'AED ' + total.toFixed(2);
      document.getElementById('c-pdp-btn-price').textContent = 'AED ' + total.toFixed(2);
    }

    window.pdpAddToCart = function() {
      const btn = document.getElementById('c-pdp-add-to-cart-btn');
      btn.textContent = 'ADDING TO CART...';

      const properties = {
        'Frame Color': selectedFrameColorName,
        'Lens Type': selectedType ? selectedType.title : 'N/A',
        'Lens Finish': selectedColorType ? (selectedColorType === 'solid' ? 'Solid Tint' : 'Gradient Tint') : 'N/A',
        'Lens Color': selectedColor ? selectedColor.value : 'N/A'
      };

      if (rxFile) {
        properties['Prescription File'] = rxFile.name;
      }

      fetch('/cart/add.js', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          items: [{
            id: selectedVariantId,
            quantity: 1,
            properties: properties
          }]
        })
      })
      .then(res => {
        if (res.ok) {
          btn.textContent = 'ADDED TO CART!';
          setTimeout(() => {
            window.location.href = '/cart';
          }, 600);
        } else {
          btn.textContent = 'ERROR - TRY AGAIN';
        }
      })
      .catch(err => {
        console.error(err);
        btn.textContent = 'ERROR';
      });
    };

    window.pdpAddDirectToCart = function() {
      const btn = document.getElementById('c-pdp-direct-add-btn');
      const originalText = btn.innerHTML;
      btn.textContent = 'ADDING TO CART...';
      btn.disabled = true;

      fetch('/cart/add.js', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          items: [{
            id: selectedVariantId,
            quantity: 1,
            properties: {
              'Customized': 'No'
            }
          }]
        })
      })
      .then(res => {
        if (res.ok) {
          btn.textContent = 'ADDED TO CART!';
          setTimeout(() => {
            window.location.href = '/cart';
          }, 600);
        } else {
          btn.textContent = 'ERROR - TRY AGAIN';
          btn.disabled = false;
          setTimeout(() => { btn.innerHTML = originalText; }, 2000);
        }
      })
      .catch(err => {
        console.error(err);
        btn.textContent = 'ERROR';
        btn.disabled = false;
        setTimeout(() => { btn.innerHTML = originalText; }, 2000);
      });
    };

    document.addEventListener('DOMContentLoaded', () => {
      renderTypes();
      renderColorGrid('c-pdp-color-grid-solid', solidColors, 'solid');
      renderColorGrid('c-pdp-color-grid-gradient', gradientColors, 'gradient');
    });
  })();
</script>
