    let selectedVariantId = {{ product.selected_or_first_available_variant.id }};
    let selectedFrameColorName = "{{ product.selected_or_first_available_variant.title | escape }}";

    // Dynamic lens type catalogue — edit here to add/remove/reprice lens types
    const lensTypes = [
      { id: 'sig-tints', title: 'Signature Tints', desc: 'Custom coloured non-prescription lenses.', price: 150 },
