{%- comment -%}
  Custom 2-Column 3-Step Product Customizer Page (Vintage Minimal Luxury Theme)
{%- endcomment -%}

<div class="c-pdp-customizer">
  <div class="c-pdp-container">
    <!-- Left Column: Horizontal Scrollable Photo Gallery Showcase -->
    <div class="c-pdp-left">
      <div class="c-pdp-gallery-wrap" id="c-pdp-gallery-wrap">
        {% if product.media.size > 0 %}
          {% for media in product.media %}
            {% if media.media_type == 'image' %}
              <div class="c-pdp-gallery-item">
                <img
                  src="{{ media | image_url: width: 1400 }}"
                  alt="{{ media.alt | default: product.title }}"
                  class="c-pdp-main-img"
                  {% if forloop.first %}
                    id="c-pdp-main-image"
                  {% endif %}
                >
              </div>
            {% endif %}
          {% endfor %}
        {% elsif product.featured_image != blank %}
          <div class="c-pdp-gallery-item">
            <img
              id="c-pdp-main-image"
              src="{{ product.featured_image | image_url: width: 1400 }}"
              alt="{{ product.title }}"
              class="c-pdp-main-img"
            >
          </div>
        {% else %}
          <div class="c-pdp-gallery-item">
            {{ 'product-1' | placeholder_svg_tag: 'c-pdp-main-img' }}
          </div>
        {% endif %}
      </div>

      {% if product.media.size > 1 %}
        <div class="c-pdp-gallery-nav">
          <button type="button" class="c-pdp-nav-btn" onclick="pdpScrollGallery(-1)" aria-label="Previous photo">
            &larr;
          </button>
          <div class="c-pdp-nav-dots" id="c-pdp-nav-dots">
            {% for media in product.media %}
              <span class="c-pdp-nav-dot{% if forloop.first %} is-active{% endif %}"></span>
            {% endfor %}
          </div>
          <button type="button" class="c-pdp-nav-btn" onclick="pdpScrollGallery(1)" aria-label="Next photo">
            &rarr;
          </button>
        </div>
      {% endif %}
    </div>

    <!-- Right Column: Minimalist 3-Step Wizard -->
    <div class="c-pdp-right">
      <!-- Progress Bar & Top Navigation (Revealed when customization starts) -->
      <div class="c-pdp-header" id="c-pdp-header" style="display: none;">
        <div class="c-pdp-progress-track" id="c-pdp-progress-track" role="presentation"></div>
        <div class="c-pdp-step-indicator">
          <span id="c-pdp-step-label">Step 1 of 3</span>
          <a href="/collections/all" class="c-pdp-close-btn" aria-label="Close customizer">&times;</a>
        </div>
      </div>

      <!-- Step Containers -->
      <div class="c-pdp-wizard-body">
        <!-- Product Overview & Default Description -->
        <div class="c-pdp-overview" id="c-pdp-overview">
          <div class="c-pdp-title-row">
            <h1 class="c-pdp-product-name">{{ product.title }}</h1>
            <div class="c-pdp-product-price">{{ product.price | money }}</div>
          </div>

          <div class="c-pdp-open-desc">
            {% if product.description != blank %}
              {{ product.description }}
            {% else %}
              <p>
                Handcrafted with premium optical materials, engineered for lightweight comfort and timeless luxury
                styling.
              </p>
            {% endif %}
          </div>

          <div class="c-pdp-spec-list">
            <span>Lens Width: 51mm</span>
            <span>Bridge: 20mm</span>
            <span>Temple: 145mm</span>
          </div>

          <button
            type="button"
            class="c-pdp-start-btn"
            onclick="pdpStartCustomizing()"
          >
            CUSTOMIZE LENSES &rarr;
          </button>
          <button
            type="button"
            class="c-pdp-direct-add-btn"
            id="c-pdp-direct-add-btn"
            onclick="pdpAddDirectToCart()"
          >
            ADD TO CART &rarr;
          </button>
        </div>

        <!-- STEP 1: Frame & Lens Selection (Revealed on click) -->
        <div id="c-pdp-step-1" class="c-pdp-step-panel" style="display: none;">
          <button type="button" class="c-pdp-back-btn" onclick="pdpShowOverview()">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
              <path d="M19 12H5M12 19l-7-7 7-7"/>
            </svg>
            <span>back to product info</span>
          </button>

          <span class="c-pdp-kicker">customization wizard</span>
          <h2 class="c-pdp-heading">select frame & lens type</h2>

          <!-- Frame Options if multiple variants -->
          {% if product.variants.size > 1 %}
            <div class="c-pdp-section-label">frame color</div>
            <div class="c-pdp-frame-swatches" id="c-pdp-frame-swatches">
              {% for variant in product.variants %}
                <div
                  class="c-pdp-frame-swatch{% if forloop.first %} is-selected{% endif %}"
                  data-variant-id="{{ variant.id }}"
                  data-image-src="{{ variant.featured_image | image_url: width: 1400 }}"
                  onclick="pdpSelectVariant(this, {{ variant.id }}, '{{ variant.featured_image | image_url: width: 1400 }}')"
                >
                  <img src="{{ variant.featured_image | image_url: width: 200 }}" alt="{{ variant.title }}">
                  <span>{{ variant.title }}</span>
                </div>
              {% endfor %}
            </div>
          {% endif %}

          <div class="c-pdp-section-label" style="margin-top: 28px;">lens type</div>
          <div class="c-pdp-options-list" id="c-pdp-type-list">
            <!-- Populated via JavaScript -->
          </div>
        </div>

        <!-- STEP 2: Prescription Upload (Signature Tints + Prescription / Optical Clear only) -->
        <div id="c-pdp-step-2" class="c-pdp-step-panel" style="display: none;">
          <button type="button" class="c-pdp-back-btn" onclick="pdpPrevStep()">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
              <path d="M19 12H5M12 19l-7-7 7-7"/>
            </svg>
            <span>previous step</span>
          </button>

          <span class="c-pdp-kicker">customization wizard</span>
          <h2 class="c-pdp-heading">add your prescription</h2>

          <div
            class="c-pdp-upload-container"
            id="c-pdp-upload-zone"
            role="button"
            tabindex="0"
            aria-describedby="c-pdp-upload-hint"
          >
            <span class="c-pdp-upload-icon-ring">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" class="c-pdp-upload-icon">
                <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4M17 8l-5-5-5 5M12 3v12"/>
              </svg>
            </span>
            <div class="c-pdp-upload-text-main">
              Drag &amp; drop your prescription
              <span class="c-pdp-upload-browse">or browse files</span>
            </div>
            <div class="c-pdp-upload-formats" id="c-pdp-upload-hint">
              <span>JPG</span>
              <span>PNG</span>
              <span>PDF</span>
              <span class="c-pdp-upload-maxsize">Up to 10 MB</span>
            </div>
            <input type="file" id="c-pdp-rx-file-input" hidden accept=".jpg,.jpeg,.png,.pdf">
          </div>

          <div class="c-pdp-upload-success" id="c-pdp-upload-success" style="display: none;">
            <span class="c-pdp-success-icon-ring">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" class="c-pdp-success-icon">
                <polyline points="20 6 9 17 4 12"/>
              </svg>
            </span>
            <div class="c-pdp-upload-success-info">
              <div class="c-pdp-success-filename" id="c-pdp-uploaded-filename"></div>
              <div class="c-pdp-success-meta" id="c-pdp-uploaded-meta"></div>
            </div>
            <div class="c-pdp-upload-actions">
              <button type="button" class="c-pdp-upload-replace-btn" id="c-pdp-upload-replace-btn">Replace</button>
              <button type="button" class="c-pdp-upload-remove-btn" id="c-pdp-upload-remove-btn" aria-label="Remove uploaded prescription">&times;</button>
            </div>
          </div>

          <div class="c-pdp-upload-error" id="c-pdp-upload-error" style="display: none;" role="alert"></div>

          <button
            type="button"
            id="c-pdp-rx-continue-btn"
            class="c-pdp-start-btn"
            style="margin-top: 24px; display: none;"
            onclick="pdpNextStep()"
          >
            continue &rarr;
          </button>
        </div>

        <!-- STEP 3: Lens Tint Color -->
        <div id="c-pdp-step-3" class="c-pdp-step-panel" style="display: none;">
          <button type="button" class="c-pdp-back-btn" onclick="pdpPrevStep()">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
              <path d="M19 12H5M12 19l-7-7 7-7"/>
            </svg>
            <span>previous step</span>
          </button>

          <span class="c-pdp-kicker">customization wizard</span>
          <h2 class="c-pdp-heading">select lens tint color</h2>

          <div class="c-pdp-tint-tabs" id="c-pdp-tint-tabs">
            <button type="button" class="c-pdp-tint-tab is-active" data-tint="solid" onclick="pdpSwitchTintTab('solid')">solid tints</button>
            <button type="button" class="c-pdp-tint-tab" data-tint="gradient" onclick="pdpSwitchTintTab('gradient')">gradient tints</button>
          </div>

          <div class="c-pdp-color-grid" id="c-pdp-color-grid-solid">
            <!-- Populated via JavaScript -->
          </div>

          <div class="c-pdp-color-grid" id="c-pdp-color-grid-gradient" style="display: none;">
            <!-- Populated via JavaScript -->
          </div>
        </div>

        <!-- STEP 4: Order Review & Cart -->
        <div id="c-pdp-step-4" class="c-pdp-step-panel" style="display: none;">
          <button type="button" class="c-pdp-back-btn" onclick="pdpPrevStep()">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
              <path d="M19 12H5M12 19l-7-7 7-7"/>
            </svg>
            <span>previous step</span>
          </button>

          <span class="c-pdp-kicker">final specification</span>
          <h2 class="c-pdp-heading">review your custom order</h2>

          <div class="c-pdp-summary-card">
            <div class="c-pdp-summary-row">
              <span>frame model</span>
              <strong>{{ product.title }}</strong>
            </div>
            <div class="c-pdp-summary-row">
              <span>frame color</span>
              <strong id="c-pdp-summary-frame-color">-</strong>
            </div>
            <div class="c-pdp-summary-row">
              <span>lens type</span>
              <strong id="c-pdp-summary-type">standard</strong>
            </div>
            <div class="c-pdp-summary-row">
              <span>lens finish</span>
              <strong id="c-pdp-summary-finish">n/a</strong>
            </div>
            <div class="c-pdp-summary-row">
              <span>lens color</span>
              <strong id="c-pdp-summary-color">n/a</strong>
            </div>
            <div class="c-pdp-summary-row">
              <span>prescription uploaded</span>
              <strong id="c-pdp-summary-rx">no</strong>
            </div>
            <div class="c-pdp-summary-divider"></div>
            <div class="c-pdp-summary-row">
              <span>frame price</span>
              <strong id="c-pdp-summary-frame-price">{{ product.price | money }}</strong>
            </div>
            <div class="c-pdp-summary-row">
              <span>lens upgrade</span>
              <strong id="c-pdp-summary-lens-price">+AED 0</strong>
            </div>
            <div class="c-pdp-summary-divider"></div>
            <div class="c-pdp-summary-row c-pdp-summary-total">
              <span>total custom investment</span>
              <strong id="c-pdp-summary-price">{{ product.price | money }}</strong>
            </div>
          </div>

          <button
            type="button"
            id="c-pdp-add-to-cart-btn"
            class="c-pdp-submit-btn"
            onclick="pdpAddToCart()"
          >
            ADD TO CART &bull; <span id="c-pdp-btn-price">{{ product.price | money }}</span>
          </button>
        </div>
      </div>
    </div>
  </div>

  <!-- Full Width Vintage Parallax Image Banner -->
  <div
    class="c-pdp-parallax-banner"
    style="background-image: url('https://cdn.shopify.com/s/files/1/0665/5036/6274/files/WhatsApp_Image_2026-07-17_at_10.31.09_PM.jpg?v=1784350056');"
  >
    <div class="c-pdp-parallax-overlay"></div>
  </div>

  <!-- Similar Products Section -->
  <section class="c-pdp-similar-section">
    <div class="c-pdp-similar-header">
      <span class="c-pdp-similar-kicker">Curated Collection</span>
      <h2 class="c-pdp-similar-title">Similar Frames</h2>
    </div>

    <div class="c-pdp-similar-grid">
      {% assign rec_products = collections.all.products %}
      {% assign count = 0 %}
      {% for rec in rec_products %}
        {% if rec.id != product.id and count < 4 %}
          <a href="{{ routes.all_products_collection_url }}" class="c-pdp-sim-card">
            <div class="c-pdp-sim-image-box">
              {% if rec.featured_image != blank %}
                <img src="{{ rec.featured_image | image_url: width: 600 }}" alt="{{ rec.title }}" loading="lazy">
              {% else %}
                {{ 'product-1' | placeholder_svg_tag }}
              {% endif %}
              <div class="c-pdp-sim-hover-tag">view frame &rarr;</div>
            </div>
            <div class="c-pdp-sim-info">
              <h3 class="c-pdp-sim-name">{{ rec.title }}</h3>
              <span class="c-pdp-sim-price">{{ rec.price | money }}</span>
            </div>
          </a>
          {% assign count = count | plus: 1 %}
        {% endif %}
      {% endfor %}
    </div>
  </section>
</div>

<style>
  /* Vintage Minimal Luxury Theme */
  .c-pdp-customizer {
    width: 100%;
    min-height: calc(100vh - 80px);
    background: #fafaf7;
    color: #2c2c2c;
    font-family: 'Canela', serif !important;
    padding-top: 0px;
  }

  .c-pdp-container {
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    min-height: calc(100vh - 80px);
    width: 100%;
    max-width: 100%;
    margin: 0;
  }

  @media (max-width: 989px) {
    .c-pdp-container {
      grid-template-columns: 1fr;
    }
  }

  /* Left Column: Horizontal Scrollable Photo Gallery */
  .c-pdp-left {
    background: #f4f1ea;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    padding: 20px 0 0 0;
    position: relative;
    border-right: 1px solid rgba(90, 31, 38, 0.08);
    overflow: hidden;
  }

  .c-pdp-gallery-wrap {
    width: 100%;
    display: flex;
    flex-direction: row;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-behavior: smooth;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
  }

  .c-pdp-gallery-wrap::-webkit-scrollbar {
    display: none;
  }

  .c-pdp-gallery-item {
    min-width: 100%;
    width: 100%;
    min-height: calc(100vh - 120px);
    display: flex;
    align-items: center;
    justify-content: center;
    scroll-snap-align: start;
    flex-shrink: 0;
    padding: 30px;
  }

  .c-pdp-main-img {
    width: 85%;
    max-width: 650px;
    height: auto;
    max-height: calc(100vh - 180px);
    object-fit: contain;
    mix-blend-mode: multiply;
    transition: transform 0.5s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .c-pdp-gallery-nav {
    position: absolute;
    bottom: 24px;
    display: flex;
    align-items: center;
    gap: 16px;
    z-index: 5;
    background: rgba(255, 255, 255, 0.6);
    backdrop-filter: blur(8px);
    padding: 6px 16px;
    border-radius: 30px;
    border: 1px solid rgba(90, 31, 38, 0.1);
  }

  .c-pdp-nav-btn {
    background: none;
    border: none;
    font-size: 14px;
    color: #5a1f26;
    cursor: pointer;
    padding: 0 4px;
    transition: opacity 0.2s ease;
  }
  .c-pdp-nav-btn:hover {
    opacity: 0.6;
  }

  .c-pdp-nav-dots {
    display: flex;
    gap: 6px;
    align-items: center;
  }

  .c-pdp-nav-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: rgba(90, 31, 38, 0.25);
    transition: all 0.3s ease;
  }

  .c-pdp-nav-dot.is-active {
    background: #5a1f26;
    width: 14px;
    border-radius: 10px;
  }

  @media (max-width: 989px) {
    .c-pdp-gallery-item {
      min-height: 380px;
    }
  }

  /* Right Column: Minimal Wizard */
  .c-pdp-right {
    padding: 48px 56px;
    display: flex;
    flex-direction: column;
    background: #fafaf7;
  }

  @media (max-width: 767px) {
    .c-pdp-right {
      padding: 28px 20px;
    }

    /* Mobile: Display Customize Button BEFORE description */
    .c-pdp-overview {
      display: flex;
      flex-direction: column;
    }

    .c-pdp-title-row {
      order: 1;
    }
    .c-pdp-direct-add-btn {
      order: 2;
      margin-top: 0;
      margin-bottom: 12px;
    }
    .c-pdp-start-btn {
      order: 3;
      margin-bottom: 24px;
    }
    .c-pdp-open-desc {
      order: 4;
    }
    .c-pdp-spec-list {
      order: 5;
    }
  }

  .c-pdp-header {
    margin-bottom: 32px;
  }

  /* One segment per step in the active flow — remaining work is legible at a
     glance instead of being inferred from a percentage width. */
  .c-pdp-progress-track {
    display: flex;
    gap: 5px;
    width: 100%;
    margin-bottom: 12px;
  }

  .c-pdp-progress-track span {
    flex: 1;
    height: 3px;
    border-radius: 2px;
    background: rgba(90, 31, 38, 0.1);
    transition: background-color 0.45s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .c-pdp-progress-track span.is-filled {
    background: #5a1f26;
  }

  .c-pdp-step-indicator {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 10px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: #8c8275;
    font-variant-numeric: tabular-nums;
  }

  .c-pdp-close-btn {
    font-size: 22px;
    color: #5a1f26;
    text-decoration: none;
    line-height: 1;
    transition: opacity 0.2s ease;
  }
  .c-pdp-close-btn:hover {
    opacity: 0.6;
  }

  .c-pdp-kicker {
    font-size: 11px;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: #8c8275;
    display: block;
    margin-bottom: 6px;
  }

  .c-pdp-heading {
    font-family: 'Canela', sans-serif !important;
    font-size: clamp(22px, 2.2vw, 28px);
    font-weight: normal;
    margin-bottom: 20px;
    color: #5a1f26;
    line-height: 1.15;
  }

  /* Product Overview & Open Description */
  .c-pdp-overview {
    margin-bottom: 28px;
  }

  .c-pdp-title-row {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    margin-bottom: 16px;
  }

  .c-pdp-product-name {
    font-family: 'Canela', sans-serif !important;
    font-size: clamp(28px, 3.5vw, 42px);
    font-weight: normal;
    color: #5a1f26;
    margin: 0;
    line-height: 1.1;
  }

  .c-pdp-product-price {
    font-size: 20px;
    font-weight: 600;
    color: #5a1f26;
    font-family: 'Canela', serif;
  }

  .c-pdp-open-desc {
    font-family: 'Canela', serif !important;
    font-style: normal !important;
    font-weight: 400 !important;
    font-size: 15px;
    color: #4a443e;
    line-height: 1.7;
    margin-bottom: 20px;
    padding-top: 16px;
    border-top: 1px solid rgba(90, 31, 38, 0.08);
  }

  .c-pdp-open-desc p {
    margin: 0 0 12px 0;
  }

  .c-pdp-open-desc p:last-child {
    margin-bottom: 0;
  }

  .c-pdp-spec-list {
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
    font-size: 11px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #8c8275;
    margin-bottom: 28px;
    padding-bottom: 16px;
    border-bottom: 1px solid rgba(90, 31, 38, 0.08);
  }

  .c-pdp-start-btn {
    width: 100%;
    padding: 18px 24px;
    background: #5a1f26;
    color: #fafaf7;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    border: none;
    border-radius: 2px;
    cursor: pointer;
    transition: background 0.3s ease, transform 0.2s ease;
  }

  .c-pdp-start-btn:hover {
    background: #3d0c11;
    transform: translateY(-1px);
  }

  .c-pdp-direct-add-btn {
    width: 100%;
    padding: 18px 24px;
    background: transparent;
    color: #5a1f26;
    border: 1px solid #5a1f26;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    border-radius: 2px;
    cursor: pointer;
    margin-top: 12px;
    transition: background 0.3s ease, color 0.3s ease, transform 0.2s ease;
  }

  .c-pdp-direct-add-btn:hover {
    background: #5a1f26;
    color: #fafaf7;
    transform: translateY(-1px);
  }

  .c-pdp-section-label {
    font-size: 11px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #5a1f26;
    margin-bottom: 12px;
    font-weight: 600;
  }

  .c-pdp-back-btn {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    background: transparent;
    border: none;
    color: #5a1f26;
    padding: 0;
    font-size: 12px;
    font-weight: 500;
    cursor: pointer;
    margin-bottom: 16px;
    transition: opacity 0.2s ease;
  }
  .c-pdp-back-btn:hover {
    opacity: 0.6;
  }

  /* Frame Swatches UI */
  .c-pdp-frame-swatches {
    display: flex;
    gap: 12px;
    overflow-x: auto;
    margin-bottom: 24px;
    padding-bottom: 4px;
  }

  .c-pdp-frame-swatch {
    border: 1px solid rgba(90, 31, 38, 0.12);
    border-radius: 4px;
