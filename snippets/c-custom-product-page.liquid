    // Dynamic lens color catalogue — edit here to add/remove/rename colors
    const solidColors = [
      { name: 'Burnt Citrus', value: 'burnt-citrus.png', image: "{{ 'burnt-citrus.png' | asset_url }}" },
      { name: 'Buttercup', value: 'buttercup.png', image: "{{ 'buttercup.png' | asset_url }}" },
      { name: 'Evergreen', value: 'evergreen.png', image: "{{ 'evergreen.png' | asset_url }}" },
      { name: 'Golden Hour', value: 'golder-hour.png', image: "{{ 'golder-hour.png' | asset_url }}" },
      { name: 'Lagoon', value: 'lagoon.png', image: "{{ 'lagoon.png' | asset_url }}" },
      { name: 'Lilac Haze', value: 'lilac-haze.png', image: "{{ 'lilac-haze.png' | asset_url }}" },
      { name: 'Moviestar Blue', value: 'moviestar-blue.png', image: "{{ 'moviestar-blue.png' | asset_url }}" },
      { name: 'Pink Velvet', value: 'pink-velvet.png', image: "{{ 'pink-velvet.png' | asset_url }}" },
      { name: 'Poolside Blue', value: 'poolside-blue.png', image: "{{ 'poolside-blue.png' | asset_url }}" },
      { name: 'Purple Haze', value: 'purple-haze.png', image: "{{ 'purple-haze.png' | asset_url }}" },
      { name: 'Sunnyside', value: 'sunnnyside.png', image: "{{ 'sunnnyside.png' | asset_url }}" }
    ];

    const gradientColors = [
      { name: 'Afterglow Fade', value: 'afterglow-fade.png', image: "{{ 'afterglow-fade.png' | asset_url }}" },
      { name: 'Blue Monday', value: 'blue-monday.png', image: "{{ 'blue-monday.png' | asset_url }}" },
      { name: 'Blue Velvet Fade', value: 'bluevelvet-fade.png', image: "{{ 'bluevelvet-fade.png' | asset_url }}" },
      { name: 'Cherry Fade', value: 'cherry-fade.png', image: "{{ 'cherry-fade.png' | asset_url }}" },
