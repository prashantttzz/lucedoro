  .drawer-localization .localization-button__icon,
  .drawer-localization .localization-button__icon svg {
    width: var(--icon-size-xs);
    height: var(--icon-size-xs);
  }

  .drawer-localization summary.is-disabled {
    pointer-events: none;
  }

  .drawer-localization .localization-wrapper {
    width: 100%;
  }

  .drawer-localization .localization-form {
    display: flex;
    flex-direction: column;
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .drawer-localization .localization-form > * {
    padding-inline: var(--padding-xl);
  }

  .drawer-localization .language-selector .svg-wrapper.icon-caret {
    transform: translateY(-50%) rotate(0deg);
  }

  .drawer-localization .language-selector .svg-wrapper.icon-caret svg {
    transform: none;
  }

  @media screen and (max-width: 749px) {
    .menu-drawer-container .header__icon--summary {
      padding: 10px;
      border-radius: 999px;
      background: transparent;
      backdrop-filter: none;
    }

    #Details-menu-drawer-container .menu-drawer,
    #Details-menu-drawer-container .menu-drawer[class*='color-scheme'] {
      width: min(88vw, 400px) !important;
      max-width: min(88vw, 400px) !important;
      background-color: #1a2620 !important;
      background-image: url('https://cdn.shopify.com/s/files/1/0665/5036/6274/files/ChatGPT_Image_Jul_18_2026_02_48_48_PM.png?v=1784366339') !important;
      background-size: cover !important;
      background-position: center !important;
      background-repeat: no-repeat !important;
      color: #fafaf7 !important;
      border-right: none !important;
      box-shadow: 0 24px 70px rgba(0, 0, 0, 0.65) !important;
      padding-top: 0 !important;
      overflow-x: hidden;
      overscroll-behavior: contain;
      min-height: 100dvh;
      display: flex;
      flex-direction: column;
      position: fixed;
      isolation: isolate;
    }

    .menu-drawer::before {
      content: '';
      position: absolute;
      inset: 0;
      z-index: 0;
      pointer-events: none;
    }

    .menu-drawer > * {
      position: relative;
      z-index: 1;
    }

    .menu-drawer__backdrop {
      backdrop-filter: blur(8px) brightness(0.65) !important;
      background: rgba(10, 10, 10, 0.35) !important;
    }

    .menu-drawer__submenu,
    .menu-drawer__inner-container,
    .menu-drawer__inner-submenu,
    .menu-drawer__navigation,
    .menu-drawer__navigation-container,
    .menu-drawer__menu,
    .menu-drawer__utility-links,
    .menu-drawer__featured-content,
    .menu-drawer__localization,
    .drawer-localization,
    .drawer-localization .localization-wrapper,
    .drawer-localization .localization-form,
    .drawer-localization .mobile-localization {
      background: transparent !important;
    }

    .menu-drawer__header-brand {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 10px;
      padding: 26px 22px 22px;
      border-bottom: none;
      background: transparent;
    }

    .menu-drawer__brand-badge {
      display: flex;
      align-items: center;
      text-decoration: none !important;
      transition: opacity 0.25s ease;
    }

    .menu-drawer__brand-badge:hover {
      opacity: 0.8;
    }

    .menu-drawer__brand-logo-image {
      height: 46px;
      width: auto;
      object-fit: contain;
      filter: brightness(0) invert(1);
    }

    .menu-drawer__brand-title {
      font-family: var(--font-heading--family, 'Canela'), sans-serif !important;
      font-size: 26px !important;
      color: #fafaf7 !important;
      letter-spacing: 0.04em !important;
      line-height: 1 !important;
    }

    .menu-drawer__close-button {
      width: 32px !important;
      height: 32px !important;
      border-radius: 0 !important;
      border: none !important;
      background: transparent !important;
      display: flex !important;
      align-items: center !important;
      justify-content: center !important;
      color: #fafaf7 !important;
      padding: 0 !important;
      flex-shrink: 0;
      transition: opacity 0.25s ease !important;
      cursor: pointer;
    }

    .menu-drawer__close-button:hover {
      opacity: 0.6;
      transform: none !important;
      color: #ffffff !important;
    }

    .menu-drawer__inner-container,
    .menu-drawer__navigation-container,
    .menu-drawer__inner-submenu {
      min-height: 100%;
    }

    .menu-drawer__navigation-container {
      flex: 1 1 auto;
    }

    .menu-drawer,
    details[open] > .menu-drawer__submenu {
      transition: transform 0.55s cubic-bezier(0.22, 1, 0.36, 1), visibility 0.55s linear,
        opacity 0.55s cubic-bezier(0.22, 1, 0.36, 1) !important;
    }

    .menu-drawer__backdrop {
      transition: opacity 0.55s cubic-bezier(0.22, 1, 0.36, 1) !important;
    }

    .menu-drawer__menu {
      padding-inline: 26px;
      padding-top: 20px;
      counter-reset: menu-drawer-index;
    }

    .menu-drawer__menu > .menu-drawer__list-item {
      min-height: auto;
    }

    .menu-drawer__menu > .menu-drawer__list-item + .menu-drawer__list-item {
      margin-top: 10px;
    }

    .menu-drawer__list-item--divider,
    .menu-drawer__menu-container--divider {
      border-block-end: none;
    }

    .menu-drawer__menu-item {
      padding: 10px 0;
      align-items: center;
      justify-content: space-between;
      transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
    }

    .menu-drawer__menu-item--mainlist {
      counter-increment: menu-drawer-index;
      min-height: auto;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
      width: 100%;
      font-family: var(--font-heading--family, 'Canela'), serif !important;
      font-style: italic;
      font-size: 20px !important;
      line-height: 1.15 !important;
      font-weight: 400 !important;
      color: #fafaf7 !important;
      letter-spacing: 0.01em !important;
      text-align: left;
      border-bottom: none;
      transition: opacity 0.3s ease;
    }

    .menu-drawer__menu-item--mainlist::before {
      display: none;
    }

    .menu-drawer__menu-item--mainlist:hover,
    .menu-drawer__menu-item--mainlist.menu-drawer__menu-item--active {
      color: #ffffff !important;
      padding-left: 0 !important;
      opacity: 0.75;
    }

    .menu-drawer__chevron {
      width: 16px;
      height: 16px;
      flex-shrink: 0;
      color: rgba(250, 250, 247, 0.85);
      transform: rotate(90deg);
      transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1);
    }

    .menu-drawer__chevron svg {
      width: 100%;
      height: 100%;
    }

    details[open] > summary .menu-drawer__chevron {
      transform: rotate(-90deg);
    }

    .menu-drawer__menu-item--parent {
      font-family: var(--font-heading--family, 'Canela'), sans-serif !important;
      font-size: 19px !important;
      line-height: 1.15 !important;
      font-weight: normal !important;
      color: #fafaf7 !important;
      padding-top: 14px;
      padding-bottom: 10px;
    }

    .menu-drawer__menu-item--parent:hover {
      color: #ffffff !important;
      padding-left: 14px !important;
    }

    .menu-drawer__menu-item--child {
      font-family: var(--font-body--family, 'Canela'), serif !important;
      font-size: 13px !important;
      line-height: 1.5 !important;
      font-weight: 500 !important;
      letter-spacing: 0.04em !important;
      color: rgba(250, 250, 247, 0.72) !important;
      padding-top: 8px;
      padding-bottom: 8px;
    }

    .menu-drawer__menu-item--child:hover {
      color: #ffffff !important;
      padding-left: 14px !important;
    }

    .menu-drawer__menu-item-text {
      white-space: normal;
      text-overflow: unset;
    }

    .menu-drawer__menu-item > .svg-wrapper {
      padding-block: 8px;
      padding-inline-start: 10px;
      color: #ffffff !important;
    }

    .menu-drawer__back-button {
      font-family: var(--font-heading--family, 'Canela'), sans-serif !important;
      font-size: 18px !important;
      color: #fafaf7 !important;
      padding: 16px 20px !important;
      border-bottom: 1px solid rgba(255, 255, 255, 0.2) !important;
    }

    .menu-drawer__back-button:hover {
      color: #ffffff !important;
    }

    .menu-drawer__back-button .icon-caret {
      color: #ffffff !important;
    }

    .menu-drawer__nav-buttons {
      border-bottom: 1px solid rgba(255, 255, 255, 0.18);
      margin-bottom: 6px;
    }

    .menu-drawer__inner-submenu,
    .menu-drawer__navigation-container {
      overflow-x: hidden;
    }

    .menu-drawer__utility-links {
      order: 3;
      margin-inline-start: 22px;
      margin-inline-end: 22px;
      margin-block: 16px 0;
      padding-top: 16px;
      border-top: 1px solid rgba(255, 255, 255, 0.22);
      background: transparent;
    }

    .menu-drawer__account {
      color: rgba(250, 250, 247, 0.85);
      font-size: 12px;
      font-family: var(--font-body--family, 'Canela'), serif;
      letter-spacing: 0.04em;
    }

    .menu-drawer__footer {
      order: 4;
      position: relative;
      margin-top: auto;
      padding: 16px 22px 24px;
    }

    .menu-drawer__footer::before {
      display: none;
    }

    .menu-drawer__footer-row {
      display: flex;
      align-items: center;
      gap: 14px;
      padding-top: 16px;
      margin-bottom: 14px;
      border-top: 1px solid rgba(255, 255, 255, 0.22);
    }

    .menu-drawer__footer-label {
      font-family: var(--font-body--family, 'Canela'), serif;
      font-size: 10px;
      letter-spacing: 0.16em;
      text-transform: uppercase;
      color: rgba(250, 250, 247, 0.55);
      white-space: nowrap;
    }

    .menu-drawer__footer-socials {
      display: flex;
      align-items: center;
      gap: 8px;
    }

    .menu-drawer__footer-social {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 34px;
      height: 34px;
      border-radius: 50%;
      border: 1px solid rgba(255, 255, 255, 0.28);
      color: #fafaf7;
      text-decoration: none;
      transition: background-color 0.25s ease, border-color 0.25s ease;
    }

    .menu-drawer__footer-social:hover {
      background: rgba(255, 255, 255, 0.12);
      border-color: rgba(255, 255, 255, 0.5);
    }

    .menu-drawer__footer-social-icon {
      width: 16px;
      height: 16px;
      fill: currentColor;
    }

    .menu-drawer__footer-copyright {
      margin: 0;
      font-family: var(--font-body--family, 'Canela'), serif;
      font-size: 10px;
      letter-spacing: 0.04em;
      color: rgba(250, 250, 247, 0.4);
      text-align: left;
    }

    .menu-drawer__featured-content {
      order: 2;
      margin-top: 24px;
      padding-top: 18px;
      padding-inline: 22px;
      padding-bottom: 20px;
      border-top: 1px solid rgba(255, 255, 255, 0.22);
    }

    .menu-drawer__featured-content-label {
      margin: 0 0 14px;
      font-family: var(--font-heading--family, 'Canela'), serif;
      font-style: italic;
      font-size: 20px;
      font-weight: 400;
      color: #fafaf7;
    }

    .menu-drawer__featured-content-list {
      display: grid;
      grid-template-columns: 1fr;
      gap: 16px;
    }

    .menu-drawer__featured-content-list-item .resource-card__link {
      display: flex;
      flex-direction: row;
      align-items: center;
      gap: 14px;
    }

    .menu-drawer__featured-content-list-item .resource-card__media {
      width: 46px;
      height: 46px;
      flex-shrink: 0;
    }

    .menu-drawer__featured-content-list-item .resource-card__image,
    .menu-drawer__featured-content-list-item .resource-card__image-wrapper {
      width: 46px !important;
      height: 46px !important;
      border-radius: 4px;
    }

    .menu-drawer__featured-content-list-item .resource-card__content {
      padding: 0;
    }

    .menu-drawer__featured-content-list-item .resource-card__title {
      font-family: var(--font-body--family, 'Canela'), sans-serif !important;
      font-size: 12px !important;
      font-weight: 500 !important;
      letter-spacing: 0.1em !important;
      text-transform: uppercase !important;
      color: #fafaf7 !important;
    }

    /* Staggered reveal of the drawer contents. The panel itself slides in over
       0.55s; each row then fades up in sequence off --menu-drawer-animation-index,
       which the markup already sets per list item. */
    .menu-drawer-container[open] .menu-drawer__animated-element {
      animation: menu-drawer-stagger-in 0.5s cubic-bezier(0.22, 1, 0.36, 1) both !important;
      animation-delay: calc(0.3s + (var(--menu-drawer-animation-index, 1) - 1) * 0.07s) !important;
    }

    .menu-drawer-container[open] .menu-drawer__header-brand {
      animation: menu-drawer-stagger-in 0.5s cubic-bezier(0.22, 1, 0.36, 1) 0.2s both;
    }

    .menu-drawer-container[open] .menu-drawer__featured-content-list-item {
      animation: menu-drawer-stagger-in 0.5s cubic-bezier(0.22, 1, 0.36, 1) both;
      animation-delay: calc(0.5s + (var(--menu-drawer-stagger-index, 1) - 1) * 0.07s);
    }

    .menu-drawer-container[open] .menu-drawer__featured-content-label,
    .menu-drawer-container[open] .menu-drawer__footer {
      animation: menu-drawer-stagger-in 0.5s cubic-bezier(0.22, 1, 0.36, 1) 0.45s both;
    }

    @keyframes menu-drawer-stagger-in {
      from {
        opacity: 0;
        transform: translateY(12px);
      }

      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    @media (prefers-reduced-motion: reduce) {
      .menu-drawer,
      details[open] > .menu-drawer__submenu,
      .menu-drawer__backdrop {
        transition-duration: 0.01ms !important;
      }

      .menu-drawer-container[open] .menu-drawer__animated-element,
      .menu-drawer-container[open] .menu-drawer__header-brand,
      .menu-drawer-container[open] .menu-drawer__featured-content-list-item,
      .menu-drawer-container[open] .menu-drawer__featured-content-label,
      .menu-drawer-container[open] .menu-drawer__footer {
        animation: none !important;
      }
    }
  }
