<div class="cfb-section">
  <div class="cfb-content ldc-animate">
    <h2 class="cfb-heading">{{ section.settings.heading }}</h2>
    {% if section.settings.subtext != blank %}
      <p class="cfb-subtext">{{ section.settings.subtext }}</p>
    {% endif %}
    
    <div class="cfb-buttons">
      {% if section.settings.button_1_label != blank %}
        <a href="{{ section.settings.button_1_link | default: '#' }}" class="cfb-btn">{{ section.settings.button_1_label }}</a>
      {% endif %}
    </div>
  </div>
</div>

<style>
  .cfb-section {
    position: relative;
    padding: 80px 20px;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    background-color: #FAFAF7; /* Off-White to contrast with burgundy above/footer below */
    margin-top: 0;
  }

  @media (min-width: 768px) {
    .cfb-section {
      padding: 100px 20px;
    }
  }

  .cfb-content {
    position: relative;
    z-index: 2;
    max-width: 600px;
  }

  .cfb-heading {
    font-family: 'ldc-font', sans-serif !important;
    font-size: clamp(36px, 6vw, 64px);
    color: #5A1F26;
    margin: 0 0 35px 0;
    font-weight: normal;
    font-style: normal;
    text-transform: none;
    letter-spacing: normal;
    line-height: 1.15;
  }

  .cfb-subtext {
    font-family: 'Canela', serif !important;
    font-size: 16px;
    line-height: 1.5;
    color: #5A1F26;
    margin: 0 auto 35px auto;
    max-width: 500px;
  }

  .cfb-buttons {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 15px;
  }

  .cfb-btn {
    display: inline-block;
    background-color: #5A1F26;
    color: #FAFAF7;
    border: 1px solid #5A1F26;
    padding: 14px 32px;
    font-family: 'Canela', serif;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    text-decoration: none;
    transition: all 0.3s ease;
  }

  .cfb-btn:hover {
    background-color: #FAFAF7;
    color: #5A1F26;
  }
</style>

{% schema %}
{
  "name": "Join the Club",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Join the Club"
    },
    {
      "type": "textarea",
      "id": "subtext",
      "label": "Subtext",
      "default": "Sign up for exclusive access to our newest collections, private sales, and behind-the-scenes content."
    },
    {
      "type": "text",
      "id": "button_1_label",
      "label": "Button Label",
      "default": "sign up"
    },
    {
      "type": "url",
      "id": "button_1_link",
      "label": "Button Link"
    }
  ],
  "presets": [
    {
      "name": "Join the Club"
    }
  ]
}
{% endschema %}
