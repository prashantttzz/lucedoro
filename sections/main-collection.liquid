{% assign default_banner_bg = 'https://cdn.shopify.com/s/files/1/0665/5036/6274/files/WhatsApp_Image_2026-07-17_at_10.31.08_PM.jpg?v=1784350056' %}
{% assign banner_bg = default_banner_bg %}
{% if section.settings.banner_image %}
  {% assign banner_bg = section.settings.banner_image | image_url: width: 3840 %}
{% endif %}

<div class="c-collection-banner ldc-animate">
  <div class="c-collection-banner__bg-wrapper">
    <img src="{{ banner_bg }}" alt="Collection Banner" class="c-collection-banner__bg" loading="eager" width="3840" height="2160">
  </div>
  <div class="c-collection-banner__overlay"></div>
  <div class="c-collection-banner__overlay-top"></div>
  <div class="c-collection-banner__content">
    <h1 class="c-collection-banner__title">customize your sunglasses</h1>
    <p class="c-collection-banner__subtitle">in three simple steps.</p>
  </div>
</div>

<script>
  (function() {
    function initParallax() {
      const bannerBg = document.querySelector('.c-collection-banner__bg');
      const container = document.querySelector('.c-collection-banner');
      if (!bannerBg || !container) return;

      let ticking = false;
      function updateParallax() {
        const rect = container.getBoundingClientRect();
        const windowHeight = window.innerHeight;
        
        if (rect.top <= windowHeight && rect.bottom >= 0) {
          const scrollDistance = windowHeight - rect.top;
          bannerBg.style.transform = `translate3d(0, ${scrollDistance * 0.25}px, 0)`;
        }
        ticking = false;
      }

      window.addEventListener('scroll', function() {
        if (!ticking) {
          window.requestAnimationFrame(updateParallax);
          ticking = true;
        }
      }, { passive: true });

      updateParallax();
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initParallax);
    } else {
      initParallax();
    }
  })();
</script>

<div class="c-collection">

  <div class="c-collection__header">
    <div class="c-collection__actions">
      <div class="c-collection__sort">
        <label for="SortBy" class="c-collection__sort-label">SORT BY:</label>
        <select name="sort_by" id="SortBy" class="c-collection__sort-select" onchange="location.href = this.value">
          {%- assign current_sort_by = collection.sort_by | default: collection.default_sort_by -%}
          {%- for option in collection.sort_options -%}
            {%- capture sort_url -%}
              {{ collection.url }}?sort_by={{ option.value }}
            {%- endcapture -%}
            <option value="{{ sort_url | strip }}" {% if option.value == current_sort_by %}selected="selected"{% endif %}>
              {{ option.name }}
            </option>
          {%- endfor -%}
        </select>
      </div>
    </div>
  </div>

  <div class="c-collection__grid">
    {%- paginate collection.products by 24 -%}
      {%- for product in collection.products -%}
        {%- render 'c-collection-product-card', product: product -%}
      {%- else -%}
        <p>No products found in this collection.</p>
      {%- endfor -%}

      {%- if paginate.pages > 1 -%}
        <div class="c-collection__pagination" style="grid-column: 1 / -1; margin-top: 40px;">
          {{ paginate | default_pagination }}
        </div>
      {%- endif -%}
    {%- endpaginate -%}
  </div>
</div>

{% render 'c-customizer-drawer' %}

{% schema %}
{
  "name": "Custom Collection",
  "settings": [
    {
      "type": "header",
      "content": "Settings are controlled via SCSS"
    },
    {
      "type": "image_picker",
      "id": "banner_image",
      "label": "Banner Background Image"
    }
  ],
  "presets": [
    {
      "name": "Custom Collection"
    }
  ]
}
{% endschema %}
