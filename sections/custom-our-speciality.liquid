<div class="cos-section" id="custom-our-speciality">
  <div class="cos-container">
    <div class="cos-layout-split">
      
      <!-- Left Column: Image + Content -->
      <div class="cos-col-left ldc-animate">
        <div class="cos-large-img-wrapper">
          {% if section.settings.image != blank %}
            {{ section.settings.image | image_url: width: 1400 | image_tag: loading: 'lazy', class: 'cos-large-img' }}
          {% else %}
            <img src="https://cdn.shopify.com/s/files/1/0665/5036/6274/files/WhatsApp_Image_2026-07-17_at_10.31.08_PM_1.jpg?v=1784350056" class="cos-large-img" alt="Mediterranean Beach" loading="lazy">
          {% endif %}
        </div>
        
        <div class="cos-left-content">
          {% if section.settings.heading != blank %}
            <h2 class="cos-left-heading">{{ section.settings.heading }}</h2>
          {% endif %}
          {% if section.settings.description != blank %}
            <div class="cos-left-desc">
              {{ section.settings.description }}
            </div>
          {% endif %}
        </div>
      </div>

      <!-- Right Column: Three Specialties -->
      <div class="cos-col-right ldc-animate">
        {% if section.settings.right_heading != blank %}
          <h3 class="cos-right-heading">{{ section.settings.right_heading }}</h3>
        {% endif %}
        
        <div class="cos-specialties-list">
          {% for block in section.blocks %}
            <div class="cos-specialty-item" {{ block.shopify_attributes }}>
              <div class="cos-spec-thumb-wrapper">
                {% if block.settings.image != blank %}
                  {{ block.settings.image | image_url: width: 300 | image_tag: loading: 'lazy', class: 'cos-spec-thumb' }}
                {% else %}
                  {% if forloop.index == 1 %}
                    <img src="https://cdn.shopify.com/s/files/1/0665/5036/6274/files/album_cover.png?v=1781997576" class="cos-spec-thumb" alt="Craft" loading="lazy">
                  {% elsif forloop.index == 2 %}
                    <img src="https://cdn.shopify.com/s/files/1/0665/5036/6274/files/WhatsApp_Image_2026-07-17_at_10.31.09_PM_1.jpg?v=1784350057" class="cos-spec-thumb" alt="Workshop" loading="lazy">
                  {% else %}
                    <img src="https://cdn.shopify.com/s/files/1/0665/5036/6274/files/WhatsApp_Image_2026-07-17_at_10.31.07_PM_1.jpg?v=1784350057" class="cos-spec-thumb" alt="Boutique" loading="lazy">
                  {% endif %}
                {% endif %}
              </div>
              
              <div class="cos-spec-content">
                <h4 class="cos-spec-title">{{ block.settings.title }}</h4>
                <p class="cos-spec-text">{{ block.settings.text }}</p>
              </div>
            </div>
          {% endfor %}
        </div>
        
        {% if section.settings.button_label != blank %}
          <div class="cos-action-row">
            <a href="{{ section.settings.button_link | default: '#' }}" class="cos-outline-btn">
              {{ section.settings.button_label }}
            </a>
          </div>
        {% endif %}
      </div>

    </div>
  </div>
</div>

<style>
  .cos-section {
    padding: 60px 2%;
    background-color: #FAFAF7; /* Brand Off-White */
  }

  .cos-container {
    max-width: 1200px;
    margin: 0 auto;
  }

  .cos-layout-split {
    display: grid;
    grid-template-columns: 1fr;
    gap: 50px;
  }

  @media (min-width: 990px) {
    .cos-layout-split {
      grid-template-columns: 1.3fr 1fr; /* 60% Left, 40% Right */
      gap: 70px;
    }
  }

  /* Left Column Styling */
  .cos-col-left {
    display: flex;
    flex-direction: column;
    text-align: left;
  }

  .cos-large-img-wrapper {
    width: 100%;
    aspect-ratio: 16/10;
    overflow: hidden;
    border-radius: 2px;
    margin-bottom: 35px;
    border: 1px solid #E9E2D6;
  }

  .cos-large-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  .cos-left-content {
    max-width: 600px;
  }

  .cos-left-heading {
    font-family: 'ldc-font', sans-serif !important;
    font-size: clamp(32px, 4.5vw, 48px);
    font-weight: normal !important;
    color: #5A1F26; /* Brand Burgundy */
    margin: 0 0 20px 0;
    text-transform: lowercase !important;
    letter-spacing: normal;
    line-height: 1.15;
  }

  .cos-left-desc {
    font-family: 'Canela', serif !important;
    font-size: 14.5px;
    line-height: 1.75;
    color: #5A1F26; /* Brand Burgundy */
  }

  /* Right Column Styling */
  .cos-col-right {
    display: flex;
    flex-direction: column;
    text-align: left;
    justify-content: flex-start;
  }

  .cos-right-heading {
    font-family: 'ldc-font', sans-serif !important;
    font-size: 26px;
    font-weight: normal !important;
    color: #5A1F26; /* Brand Burgundy */
    margin: 0 0 35px 0;
    text-transform: lowercase !important;
    letter-spacing: normal;
    line-height: 1.15;
  }

  .cos-specialties-list {
    display: flex;
    flex-direction: column;
    gap: 30px;
    margin-bottom: 40px;
  }

  .cos-specialty-item {
    display: flex;
    gap: 20px;
    align-items: flex-start;
  }

  .cos-spec-thumb-wrapper {
    width: 90px;
    height: 90px;
    flex-shrink: 0;
    overflow: hidden;
    border-radius: 2px;
    border: 1px solid #E9E2D6;
  }

  .cos-spec-thumb {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .cos-spec-content {
    display: flex;
    flex-direction: column;
  }

  .cos-spec-title {
    font-family: 'ldc-font', sans-serif !important;
    font-size: 17px;
    font-weight: normal !important;
    color: #5A1F26;
    margin: 0 0 6px 0;
    text-transform: lowercase !important;
    letter-spacing: normal;
    line-height: 1.15;
  }

  .cos-spec-text {
    font-family: 'Canela', serif !important;
    font-size: 13px;
    line-height: 1.6;
    color: #5A1F26;
    margin: 0;
  }

  .cos-action-row {
    margin-top: 15px;
  }

  .cos-outline-btn {
    display: inline-block;
    background-color: transparent;
    color: #5A1F26; /* Brand Burgundy */
    border: 1px solid #5A1F26;
    padding: 12px 32px;
    font-family: 'Canela', serif;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    text-decoration: none;
    transition: all 0.3s ease;
    border-radius: 100px; /* Rounded outline button like Late Checkout */
    text-align: center;
  }

  .cos-outline-btn:hover {
    background-color: #5A1F26;
    color: #FAFAF7;
  }
</style>

{% schema %}
{
  "name": "Our Speciality",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Left Heading",
      "default": "OUR SPECIALITY"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Left Description",
      "default": "<p>We believe great design goes beyond appearance—it reflects authenticity, quality, and purpose. From concept to creation, our commitment to excellence ensures that each collection offers lasting beauty, everyday functionality, and a meaningful connection to the inspirations behind it.</p>"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Left Image"
    },
    {
      "type": "text",
      "id": "right_heading",
      "label": "Right Heading",
      "default": "OUR VALUES"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button Label",
      "default": "JOIN THE INNER CIRCLE"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link"
    }
  ],
  "blocks": [
    {
      "type": "specialty",
      "name": "Specialty",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Thumbnail"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Specialty Title"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Description",
          "default": "Description of the specialty item."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Our Speciality",
      "blocks": [
        {
          "type": "specialty",
          "settings": {
            "title": "Timeless Design",
            "text": "Our collections are inspired by timeless design, blending traditional artistry with modern aesthetics."
          }
        },
        {
          "type": "specialty",
          "settings": {
            "title": "Exceptional Craftsmanship",
            "text": "Every piece is thoughtfully created using premium materials and meticulous attention to detail."
          }
        },
        {
          "type": "specialty",
          "settings": {
            "title": "Rich Stories & Heritage",
            "text": "Celebrating heritage and the rich stories found in the places, people, and cultures that shape our world."
          }
        }
      ]
    }
  ]
}
{% endschema %}
