<div class="cbg-section" id="custom-bento-grid">
  <div class="cbg-grid">
    {% for block in section.blocks %}
      <div class="cbg-card cbg-image-card ldc-animate" {{ block.shopify_attributes }}>
        <div class="cbg-img-wrapper">
          {% if block.settings.image != blank %}
            {{ block.settings.image | image_url: width: 1200 | image_tag: loading: 'lazy', class: 'cbg-img' }}
          {% else %}
            {% if forloop.index == 1 %}
              <img src="https://cdn.shopify.com/s/files/1/0665/5036/6274/files/WhatsApp_Image_2026-07-17_at_10.31.07_PM_1.jpg?v=1784350057" class="cbg-img" loading="lazy" width="1200" height="1200">
            {% elsif forloop.index == 2 %}
              <img src="https://cdn.shopify.com/s/files/1/0665/5036/6274/files/WhatsApp_Image_2026-07-17_at_10.31.09_PM_1.jpg?v=1784350057" class="cbg-img" loading="lazy" width="1200" height="1200">
            {% elsif forloop.index == 3 %}
              <img src="https://cdn.shopify.com/s/files/1/0665/5036/6274/files/WhatsApp_Image_2026-07-21_at_9.34.38_PM.jpg?v=1784652067" class="cbg-img" loading="lazy" width="1200" height="1200">
            {% else %}
              {{ 'lifestyle-1' | placeholder_svg_tag: 'cbg-img placeholder-svg' }}
            {% endif %}
          {% endif %}
        </div>
      </div>
    {% endfor %}
  </div>
</div>

<style>
  .cbg-section {
    padding: 60px 5% 0;
    background-color: #5A1F26; /* Burgundy */
    position: relative;
  }

  .cbg-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 20px;
  }

  @media (min-width: 768px) {
    .cbg-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .cbg-grid {
      grid-template-columns: 1.2fr 1fr;
      grid-template-rows: minmax(320px, auto) minmax(320px, auto);
      grid-template-areas:
        "card1 card2"
        "card1 card3";
      gap: 24px;
    }

    .cbg-card {
      min-height: 0;
      height: 100%;
    }

    .cbg-card:nth-child(1) { grid-area: card1; }
    .cbg-card:nth-child(2) { grid-area: card2; }
    .cbg-card:nth-child(3) { grid-area: card3; }
  }

  .cbg-card {
    position: relative;
    border-radius: 4px;
    overflow: hidden;
    display: flex;
    min-height: 450px;
  }
  
  @media (min-width: 1024px) {
    .cbg-card {
      min-height: 550px;
    }
  }

  /* Image Card */
  .cbg-image-card {
    flex-direction: column;
    justify-content: flex-end;
  }

  .cbg-img-wrapper {
    position: absolute;
    top: -20%;
    left: 0;
    width: 100%;
    height: 140%;
    z-index: 1;
  }

  .cbg-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    will-change: transform;
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const bentoBgs = document.querySelectorAll('.cbg-img');
    if (bentoBgs.length === 0) return;

    let ticking = false;
    window.addEventListener('scroll', () => {
      if (!ticking) {
        window.requestAnimationFrame(() => {
          bentoBgs.forEach((bg) => {
            const container = bg.closest('.cbg-card');
            if (container) {
              const rect = container.getBoundingClientRect();
              const windowHeight = window.innerHeight;
              
              if (rect.top <= windowHeight && rect.bottom >= 0) {
                const scrollDistance = windowHeight - rect.top;
                bg.style.transform = `translateY(${scrollDistance * 0.15}px)`;
              }
            }
          });
          ticking = false;
        });
        ticking = true;
      }
    });
  });
</script>

{% schema %}
{
  "name": "Custom Bento Grid",
  "tag": "section",
  "settings": [],
  "blocks": [
    {
      "type": "image_card",
      "name": "Image Card",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Custom Bento Grid",
      "blocks": [
        { "type": "image_card" },
        { "type": "image_card" },
        { "type": "image_card" },
        { "type": "image_card" }
      ]
    }
  ]
}
{% endschema %}
