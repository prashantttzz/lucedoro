      { name: 'Sunnyside', value: 'sunnnyside.png', image: "{{ 'sunnnyside.png' | asset_url }}", opacity: 0.45 }
    ];

    const gradientColors = [
      { name: 'Afterglow Fade', value: 'afterglow-fade.png', image: "{{ 'afterglow-fade.png' | asset_url }}", opacity: 0.55 },
      { name: 'Blue Monday', value: 'blue-monday.png', image: "{{ 'blue-monday.png' | asset_url }}", opacity: 0.5 },
      { name: 'Blue Velvet Fade', value: 'bluevelvet-fade.png', image: "{{ 'bluevelvet-fade.png' | asset_url }}", opacity: 0.5 },
