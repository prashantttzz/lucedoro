      { name: 'Military Fade', value: 'military-fade.png', image: "{{ 'military-fade.png' | asset_url }}", opacity: 0.55 },
      { name: 'Morning Tide', value: 'morning-tide.png', image: "{{ 'morning-tide.png' | asset_url }}", opacity: 0.5 },
      { name: 'Moss Fade', value: 'moss-fade.png', image: "{{ 'moss-fade.png' | asset_url }}", opacity: 0.55 },
      { name: 'Red Velvet Fade', value: 'redvelvet-fade.png', image: "{{ 'redvelvet-fade.png' | asset_url }}", opacity: 0.5 },
      { name: 'Steel Fade', value: 'steel-fade.png', image: "{{ 'steel-fade.png' | asset_url }}", opacity: 0.6 }
    ];

    // ------------------- APPLICATION STATE -------------------
    let state = {
      modelKey: Object.keys(modelsData)[0],
      frameColorIndex: 0,
      lensTypeId: 'sig-tints',
      rxFile: null,
      lensColorName: null,
      lensColorValue: null,
      lensColorHex: null,
      lensColorType: null, // 'solid' or 'gradient'
      currentStep: 1,
      totalSteps: 4 // Signature Tints has 4 steps: Type, Rx (cond), Color, Review. Let's make step numbers dynamic based on flow!
    };

    // ------------------- STEP ROUTING LOGIC -------------------
    // Step panels indices relative to state steps:
    // We map step index to actual DOM panels:
    // Panel 1: Type
    // Panel 2: Prescription
    // Panel 3: Color Select
    // Panel 4: Review
    function getStepsFlow() {
      const type = state.lensTypeId;
      if (type === 'sig-tints') {
        return [1, 3, 4]; // Panel 1 (Type) -> Panel 3 (Color) -> Panel 4 (Review)
      } else if (type === 'sig-tints-rx') {
        return [1, 2, 3, 4]; // Panel 1 (Type) -> Panel 2 (Prescription) -> Panel 3 (Color) -> Panel 4 (Review)
      } else if (type === 'digital-blue') {
        return [1, 4]; // Panel 1 (Type) -> Panel 4 (Review)
      } else if (type === 'optical-clear') {
        return [1, 2, 4]; // Panel 1 (Type) -> Panel 2 (Prescription) -> Panel 4 (Review)
      }
      return [1, 4];
    }

    // ------------------- INITIALIZE GALLERY VIEW -------------------
    window.onload = function() {
      renderGallery();
      initInteractive();
    };

    let activePriceFilter = 'all';
    let activeSort = 'featured';

    function priceMatches(price, filter) {
      if (filter === 'all') return true;
      if (filter === 'under-700') return price < 700;
      if (filter === '700-800') return price >= 700 && price <= 800;
      if (filter === 'over-800') return price > 800;
      return true;
    }

    function ldcApplyFilters() {
      const cards = document.querySelectorAll('.ldc-product-card');
      cards.forEach(card => {
        const price = parseFloat(card.getAttribute('data-price'));
        const matches = priceMatches(price, activePriceFilter);

        if (matches) {
          card.style.display = 'flex';
          setTimeout(() => card.style.opacity = '1', 50);
        } else {
          card.style.opacity = '0';
          setTimeout(() => card.style.display = 'none', 300);
        }
      });
    }

    window.ldcFilterPrice = function(filter) {
      activePriceFilter = filter;
      const tabsWrap = document.getElementById('ldc-price-tabs');
      if (tabsWrap) {
        tabsWrap.querySelectorAll('.ldc-chip').forEach(tab => tab.classList.remove('active'));
        const clickedTab = Array.from(tabsWrap.querySelectorAll('.ldc-chip')).find(tab =>
          tab.getAttribute('onclick').includes(`'${filter}'`)
        );
        if (clickedTab) clickedTab.classList.add('active');
      }
      ldcApplyFilters();
    };

    window.ldcSortGallery = function(sortValue) {
      activeSort = sortValue;
      renderGallery();
      ldcApplyFilters();
    };

    function getSortedModelKeys() {
      const keys = Object.keys(modelsData);
      if (activeSort === 'price-asc') {
        return keys.sort((a, b) => modelsData[a].price - modelsData[b].price);
      }
      if (activeSort === 'price-desc') {
        return keys.sort((a, b) => modelsData[b].price - modelsData[a].price);
      }
      if (activeSort === 'name-asc') {
        return keys.sort((a, b) => modelsData[a].name.localeCompare(modelsData[b].name));
      }
      return keys;
    }

    function renderGallery() {
      const grid = document.getElementById('ldc-gallery-grid');
      if (!grid) return;
      grid.innerHTML = '';

      getSortedModelKeys().forEach(key => {
        const model = modelsData[key];
        const defaultColor = model.colors[0];

        // Create Card Element
        const card = document.createElement('div');
        card.className = 'ldc-product-card';
        card.setAttribute('data-model', key);
        card.setAttribute('data-price', model.price);

        card.innerHTML = `
          <div class="ldc-card-img-wrap">
            <img src="${defaultColor.img}" alt="${model.name} Eyewear" class="ldc-card-img" id="img-${key}">
          </div>
          <div class="ldc-card-meta">
            <h2 class="ldc-card-name">${model.name}</h2>
            <div class="ldc-card-price">AED ${model.price}</div>
          </div>
          <div class="ldc-card-swatches" id="swatches-${key}">
            <!-- Swatches -->
          </div>
        `;

        card.addEventListener('click', () => {
          if (model.url) {
            window.location.href = model.url;
          } else {
            ldcLaunchCustomizer(key);
          }
        });

        grid.appendChild(card);

        // Render Swatches
        const swatchContainer = document.getElementById(`swatches-${key}`);
        model.colors.forEach((col, idx) => {
          const swDot = document.createElement('div');
          swDot.className = `ldc-swatch-dot ${idx === 0 ? 'active' : ''}`;
          swDot.innerHTML = `<span style="background-color: ${col.swatch};"></span>`;
          
          swDot.addEventListener('click', (e) => {
            e.stopPropagation();
            // Update Card Image
            document.getElementById(`img-${key}`).src = col.img;
            
            // Remove active from siblings
            swatchContainer.querySelectorAll('.ldc-swatch-dot').forEach(el => el.classList.remove('active'));
            swDot.classList.add('active');

            // Save choice in case they click customize immediately
            if (state.modelKey === key) {
              state.frameColorIndex = idx;
            }
          });

          swatchContainer.appendChild(swDot);
        });
      });

      scatterPromoTiles(grid);
    }

    // Insert the two promo banners at fixed slots so they line up with the grid's row layout
    const PROMO_TILE_POSITIONS = [2, 6];

    function scatterPromoTiles(grid) {
      const tpl = document.getElementById('ldc-promo-tiles-template');
      if (!tpl) return;
      const tiles = Array.from(tpl.content.cloneNode(true).children);

      tiles.forEach((tile, i) => {
        const cards = Array.from(grid.children).filter(el => !el.classList.contains('ldc-bento-tile'));
        const position = PROMO_TILE_POSITIONS[i];
        const referenceCard = cards[position];
        if (referenceCard) {
          grid.insertBefore(tile, referenceCard);
        } else {
          grid.appendChild(tile);
        }
      });
    }

    // ------------------- INTERACTIVE WIZARD LOGIC -------------------
    window.ldcLaunchCustomizer = function(modelKey) {
      state.modelKey = modelKey;
      
      // Determine which color was selected in card swatches
      const swContainer = document.getElementById(`swatches-${modelKey}`);
      const activeDotIdx = Array.from(swContainer.children).findIndex(dot => dot.classList.contains('active'));
      state.frameColorIndex = activeDotIdx !== -1 ? activeDotIdx : 0;

      // Set state default
      state.currentStep = 1;

      // Render Step lists
      renderStep1Options();
      renderStep3Swatches();

      // Show wizard screen, hide gallery
      document.getElementById('ldc-gallery-view').style.display = 'none';
      document.getElementById('ldc-wizard-view').style.display = 'block';

      // Update Preview
      updatePreview();
      updateStepView();
    };

    window.ldcExitCustomizer = function() {
      document.getElementById('ldc-wizard-view').style.display = 'none';
      document.getElementById('ldc-gallery-view').style.display = 'block';
    };

    function updatePreview() {
      const model = modelsData[state.modelKey];
      const color = model.colors[state.frameColorIndex];

      document.getElementById('ldc-preview-model-name').textContent = model.name;
      document.getElementById('ldc-preview-frame-color').textContent = `${color.name} Frame`;
      document.getElementById('ldc-preview-frame-img').src = color.img;

      // Apply Lens Color overlay simulation
      const overlay = document.getElementById('ldc-preview-lens-overlay');
      if (state.lensColorHex && (state.lensTypeId === 'sig-tints' || state.lensTypeId === 'sig-tints-rx')) {
        overlay.style.background = state.lensColorHex;
        overlay.style.opacity = state.lensColorOpacity || 0.45;
      } else if (state.lensTypeId === 'digital-blue') {
        overlay.style.background = 'rgba(30, 144, 255, 0.15)'; // Blue light filter tint
        overlay.style.opacity = 1;
      } else {
        overlay.style.background = 'transparent';
        overlay.style.opacity = 0;
      }
    }

    function renderStep1Options() {
      const container = document.getElementById('ldc-lens-type-options');
      if (!container) return;
      container.innerHTML = '';

      lensTypes.forEach(t => {
        const div = document.createElement('div');
        div.className = `ldc-option-card ${state.lensTypeId === t.id ? 'active' : ''}`;
        div.innerHTML = `
          <div class="ldc-opt-info">
            <div class="ldc-opt-title">${t.name}</div>
            <div class="ldc-opt-desc">${t.desc}</div>
          </div>
          <div class="ldc-opt-price">+ AED ${t.upgrade}</div>
        `;

        div.onclick = () => {
          state.lensTypeId = t.id;
          container.querySelectorAll('.ldc-option-card').forEach(el => el.classList.remove('active'));
          div.classList.add('active');
          
          // Clear selections if incompatible
          if (t.id === 'digital-blue' || t.id === 'optical-clear') {
            state.lensColorName = null;
            state.lensColorHex = null;
          } else if (!state.lensColorName) {
            // Default to first solid color
            state.lensColorName = solidColors[0].name;
            state.lensColorValue = solidColors[0].value;
            state.lensColorHex = `url('${solidColors[0].image}') center/cover no-repeat`;
            state.lensColorOpacity = solidColors[0].opacity;
            state.lensColorType = 'solid';
          }

          updatePreview();
          updatePricing();
        };

        container.appendChild(div);
      });
    }

    function renderStep3Swatches() {
      // Solid Swatches
      const solidContainer = document.getElementById('ldc-solid-swatches');
      if (solidContainer) {
        solidContainer.innerHTML = '';
        solidColors.forEach(c => {
          const card = document.createElement('div');
          card.className = `ldc-lens-swatch-card ${state.lensColorName === c.name ? 'active' : ''}`;
          card.innerHTML = `
            <div class="ldc-lens-swatch-circle" style="background: url('${c.image}') center/cover no-repeat;"></div>
            <div class="ldc-lens-swatch-name">${c.name}</div>
          `;
          card.onclick = () => {
            selectLensColor(c.name, c.value, `url('${c.image}') center/cover no-repeat`, c.opacity, 'solid');
            solidContainer.querySelectorAll('.ldc-lens-swatch-card').forEach(el => el.classList.remove('active'));
            document.getElementById('ldc-gradient-swatches').querySelectorAll('.ldc-lens-swatch-card').forEach(el => el.classList.remove('active'));
            card.classList.add('active');
          };
          solidContainer.appendChild(card);
        });
      }

      // Gradient Swatches
      const gradContainer = document.getElementById('ldc-gradient-swatches');
      if (gradContainer) {
        gradContainer.innerHTML = '';
        gradientColors.forEach(c => {
          const card = document.createElement('div');
          card.className = `ldc-lens-swatch-card ${state.lensColorName === c.name ? 'active' : ''}`;
          card.innerHTML = `
            <div class="ldc-lens-swatch-circle" style="background: url('${c.image}') center/cover no-repeat;"></div>
            <div class="ldc-lens-swatch-name">${c.name}</div>
          `;
          card.onclick = () => {
            selectLensColor(c.name, c.value, `url('${c.image}') center/cover no-repeat`, c.opacity, 'gradient');
            gradContainer.querySelectorAll('.ldc-lens-swatch-card').forEach(el => el.classList.remove('active'));
            document.getElementById('ldc-solid-swatches').querySelectorAll('.ldc-lens-swatch-card').forEach(el => el.classList.remove('active'));
            card.classList.add('active');
          };
          gradContainer.appendChild(card);
        });
      }
    }

    function selectLensColor(name, value, color, opacity, type) {
      state.lensColorName = name;
      state.lensColorValue = value;
      state.lensColorHex = color;
      state.lensColorOpacity = opacity;
      state.lensColorType = type;
      updatePreview();
    }

    function updatePricing() {
      const model = modelsData[state.modelKey];
      const upgrade = lensTypes.find(t => t.id === state.lensTypeId).upgrade;
      const total = model.price + upgrade;

      // Update in right sidebar footer
      document.getElementById('ldc-wiz-price-amount').textContent = `AED ${total}`;

      // Update in Summary card (Step 5)
      document.getElementById('ldc-sum-frame-price').textContent = `AED ${model.price}`;
      document.getElementById('ldc-sum-lens-price').textContent = `+ AED ${upgrade}`;
      document.getElementById('ldc-sum-total-price').textContent = `AED ${total}`;
    }

    function updateStepView() {
      const flow = getStepsFlow();
      const panelIdx = flow[state.currentStep - 1];

      // Hide all panels
      document.querySelectorAll('.ldc-step-panel').forEach(p => p.classList.remove('active'));
      
      // Show correct panel
      document.getElementById(`ldc-step-panel-${panelIdx}`).classList.add('active');

      // Update progress bar width
      const pct = ((state.currentStep - 1) / (flow.length - 1)) * 100;
      document.getElementById('ldc-progress-bar').style.width = `${pct}%`;

      // Update top progress labels
      document.getElementById('ldc-wiz-step-num').textContent = `Step ${state.currentStep} of ${flow.length}`;
      
      const stepNames = {
        1: 'Choose Lens Type',
        2: 'Add Your Prescription',
        3: 'Select Lens Color',
        4: 'Review Customization'
      };
      document.getElementById('ldc-wiz-step-name').textContent = stepNames[panelIdx];

      // If last step, show Add to Cart, hide Next
      if (state.currentStep === flow.length) {
        document.getElementById('ldc-wiz-next-btn').style.display = 'none';
        document.getElementById('ldc-wiz-cart-btn').style.display = 'flex';
        renderSummaryCard();
      } else {
        document.getElementById('ldc-wiz-next-btn').style.display = 'flex';
        document.getElementById('ldc-wiz-cart-btn').style.display = 'none';
      }

      updatePricing();
    }

    window.ldcNextStep = function() {
      const flow = getStepsFlow();
      
      // Validation checks before proceeding
      const currentPanelId = flow[state.currentStep - 1];
      if (currentPanelId === 2 && !state.rxFile) {
        // Must upload a file
        alert('Please upload your prescription file to continue.');
        return;
      }

      if (state.currentStep < flow.length) {
        state.currentStep++;
        updateStepView();
      }
    };

    window.ldcPrevStep = function() {
      if (state.currentStep > 1) {
        state.currentStep--;
        updateStepView();
      } else {
        ldcExitCustomizer();
      }
    };

    function renderSummaryCard() {
      const model = modelsData[state.modelKey];
      const color = model.colors[state.frameColorIndex];
      const type = lensTypes.find(t => t.id === state.lensTypeId);

      document.getElementById('ldc-sum-model').textContent = model.name;
      document.getElementById('ldc-sum-frame-color').textContent = color.name;
      document.getElementById('ldc-sum-lens-type').textContent = type.name;

      const lensColorRow = document.querySelector('.id-lens-color-row');
      if (state.lensColorName) {
        lensColorRow.style.display = 'flex';
        document.getElementById('ldc-sum-lens-color').textContent = `${state.lensColorName} (${state.lensColorType})`;
      } else {
        lensColorRow.style.display = 'none';
      }

      const rxRow = document.querySelector('.id-rx-uploaded-row');
      if (type.id.includes('rx') || type.id === 'optical-clear') {
        rxRow.style.display = 'flex';
        document.getElementById('ldc-sum-rx-uploaded').textContent = state.rxFile ? 'Yes' : 'No';
      } else {
        rxRow.style.display = 'none';
      }
    }

    // ------------------- FILE UPLOAD RX SYSTEM -------------------
    function initInteractive() {
      const zone = document.getElementById('ldc-upload-zone');
      const input = document.getElementById('ldc-rx-file-input');

      if (zone && input) {
        zone.onclick = () => input.click();
        
        zone.ondragover = (e) => {
          e.preventDefault();
          zone.style.borderColor = 'var(--ldc-burgundy)';
        };

        zone.ondragleave = () => {
          zone.style.borderColor = 'rgba(0,0,0,0.15)';
        };

        zone.ondrop = (e) => {
          e.preventDefault();
          zone.style.borderColor = 'rgba(0,0,0,0.15)';
          if (e.dataTransfer.files.length > 0) {
            handleFileSelect(e.dataTransfer.files[0]);
          }
        };

        input.onchange = () => {
          if (input.files.length > 0) {
            handleFileSelect(input.files[0]);
          }
        };
      }
    }

    window.ldcTriggerUpload = function() {
      document.getElementById('ldc-rx-file-input').click();
    };

    function handleFileSelect(file) {
      const validTypes = ['image/jpeg', 'image/jpg', 'image/png', 'application/pdf'];
      if (!validTypes.includes(file.type)) {
        document.getElementById('ldc-upload-error').style.display = 'block';
        return;
      }

      document.getElementById('ldc-upload-error').style.display = 'none';
      state.rxFile = file;

      // Display success UI
      document.getElementById('ldc-upload-zone').style.display = 'none';
      document.getElementById('ldc-upload-success').style.display = 'flex';
      document.getElementById('ldc-uploaded-filename').textContent = file.name;
    }

    // ------------------- CART SUBMIT ACTION -------------------
    window.ldcAddToCart = function() {
      const model = modelsData[state.modelKey];
      const color = model.colors[state.frameColorIndex];
      const type = lensTypes.find(t => t.id === state.lensTypeId);

      // Construct cart line item properties
      const properties = {
        'Model': model.name,
        'Frame Color': color.name,
        'Lens Type': type.name,
        'Lens Finish': state.lensColorType ? (state.lensColorType === 'solid' ? 'Solid Tint' : 'Gradient Tint') : 'N/A',
        'Lens Color': state.lensColorValue || 'Clear / Default',
      };

      if (state.rxFile) {
        properties['Prescription File'] = state.rxFile.name; // In real Shopify store, this would upload the file to Shopify CDN or custom host
      }

      const cartBtn = document.getElementById('ldc-wiz-cart-btn');
      cartBtn.disabled = true;
      cartBtn.textContent = 'Adding to Cart...';

      // We will make an AJAX post request to Shopify /cart/add.js
      // To ensure that this works dynamically on mock data, we add a generic custom product variant id if present in the catalog, 
      // or we simulate adding the item. In the real store, the developer would map state.modelKey to a Shopify product variant ID.
      // We will look for any variant or use a placeholder, and attach properties.
      
      const variantId = color.id || 42106553827490;

      const formData = {
        items: [{
          id: variantId,
          quantity: 1,
          properties: properties
        }]
      };

      fetch('/cart/add.js', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json'
        },
        body: JSON.stringify(formData)
      })
      .then(response => response.json())
      .then(data => {
        cartBtn.textContent = 'Success!';
        setTimeout(() => {
          cartBtn.disabled = false;
          cartBtn.textContent = 'Add to Cart';
          
          // Open the cart drawer if it exists in the theme
          const cartDrawer = document.getElementById('CartDrawer') || document.getElementById('cart-drawer');
          if (cartDrawer) {
            cartDrawer.setAttribute('open', '');
          } else {
            // Redirect to standard cart page
            window.location.href = '/cart';
          }
        }, 1500);
      })
      .catch(error => {
        console.error('Error adding customized product to cart:', error);
        alert('Customized item added to your custom setup (mock simulation). All properties: ' + JSON.stringify(properties));
        cartBtn.disabled = false;
        cartBtn.textContent = 'Add to Cart';
      });
    };

  })();
</script>

