<script>
  (function () {
    // Parallax drift on the collection hero banner.
    function initHeroParallax() {
      const bg = document.querySelector('.ldc-gallery-hero__bg');
      const container = document.querySelector('.ldc-gallery-hero');
      if (!bg || !container) return;
      if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

      let ticking = false;

      function update() {
        ticking = false;

        const rect = container.getBoundingClientRect();
        const viewportHeight = window.innerHeight;
        if (rect.bottom < 0 || rect.top > viewportHeight) return;

        // 0 as the banner enters from the bottom, 1 once it has left the top.
        const progress = (viewportHeight - rect.top) / (viewportHeight + rect.height);

        // The bg layer is inset -35% and 170% tall, so it can travel 35% of the
        // container height each way before an edge shows. Stay under that.
        const maxShift = rect.height * 0.32;
        const shift = (progress - 0.5) * 2 * maxShift;

        bg.style.transform = 'translate3d(0, ' + shift.toFixed(2) + 'px, 0)';
      }

      function requestTick() {
        if (!ticking) {
          window.requestAnimationFrame(update);
          ticking = true;
        }
      }

      window.addEventListener('scroll', requestTick, { passive: true });
      window.addEventListener('resize', requestTick, { passive: true });
      update();
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initHeroParallax);
    } else {
      initHeroParallax();
    }
  })();
</script>

<script>
  (function() {
    // Helper to determine color swatch by name
    function getSwatchColor(colorName) {
      const name = colorName.toLowerCase();
      if (name.includes('emerald') || name.includes('green')) return '#2E3B33';
      if (name.includes('amber') || name.includes('orange') || name.includes('gold')) return '#b87333';
      if (name.includes('riviera') || name.includes('blue')) return '#1e3d59';
      if (name.includes('oak') || name.includes('brown')) return '#8b5a2b';
      if (name.includes('obsidian') || name.includes('black')) return '#111111';
      if (name.includes('tortoise')) return '#5c4033';
      if (name.includes('honey')) return '#e4a010';
      if (name.includes('crystal') || name.includes('clear')) return '#e2f0d9';
      if (name.includes('silver')) return '#c0c0c0';
      if (name.includes('rose')) return '#b76e79';
      return '#cccccc';
    }

    // ------------------- DYNAMIC CONFIGURATION & DATA -------------------
    let modelsData = {
      {%- if ldc_collection.products.size > 0 -%}
        {%- for product in ldc_collection.products -%}
          "{{ product.handle }}": {
            name: "{{ product.title | escape }}",
            price: {{ product.price | divided_by: 100 | default: 650 }},
            url: "{{ product.url }}",
            hoverImg: "{{ product.images[1] | default: product.featured_image | image_url: width: 1400 }}",
            colors: [
              {%- for variant in product.variants -%}
                {
                  name: "{{ variant.title | escape }}",
                  swatch: getSwatchColor("{{ variant.title | escape }}"),
                  img: "{{ variant.featured_image | default: product.featured_image | image_url: width: 1400 }}",
                  id: {{ variant.id }}
                }{%- unless forloop.last -%},{%- endunless -%}
              {%- endfor -%}
            ]
          }{%- unless forloop.last -%},{%- endunless -%}
        {%- endfor -%}
      {%- endif -%}
    };

    // If no dynamic products found, fall back to mock data
    if (Object.keys(modelsData).length === 0) {
      modelsData = {
        park: {
          name: 'Park',
          price: 650,
          hoverImg: 'https://cdn.shopify.com/s/files/1/0665/5036/6274/files/WhatsApp_Image_2026-07-21_at_9.35.24_PM.jpg?v=1784652068',
          colors: [
