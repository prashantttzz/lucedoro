{% comment %}
  Premium Full-Page Eyewear & Lens Customizer for Luce D'Oro Club
{% endcomment %}

{%- comment -%}
  On /collections and any other template without a collection in scope, fall
  back to the "all" collection so the page renders the same catalogue as
  /collections/all rather than an empty grid.
{%- endcomment -%}
{%- liquid
  assign ldc_collection = collection
  if ldc_collection == blank or ldc_collection.products.size == 0
    assign ldc_collection = collections.all
  endif
-%}

<div class="ldc-customizer-section color-{{ section.settings.color_scheme }}">
  <!-- VIEW 1: FRAME GALLERY SELECTION -->
  <div id="ldc-gallery-view" class="ldc-gallery-container">
    <!-- 1. EDITORIAL LIFESTYLE HERO BANNER -->
    {%- liquid
      assign hero_img = section.settings.hero_image
      if hero_img == blank
        assign hero_url = 'https://cdn.shopify.com/s/files/1/0665/5036/6274/files/WhatsApp_Image_2026-07-21_at_4.18.49_PM.jpg?v=1784632674'
      else
        assign hero_url = hero_img | image_url: width: 2400
      endif
    -%}
    <div class="ldc-gallery-hero">
      <div class="ldc-gallery-hero__bg" style="background-image: url('{{ hero_url }}');"></div>
      <div class="ldc-hero-overlay"></div>
      <div class="ldc-hero-content">
        {%- if section.settings.hero_kicker != blank -%}
          <span class="ldc-hero-subtitle">{{ section.settings.hero_kicker | escape }}</span>
        {%- endif -%}
        {%- if section.settings.hero_title != blank -%}
          <h2 class="ldc-hero-title">{{ section.settings.hero_title | escape }}</h2>
        {%- endif -%}
        {%- if section.settings.hero_desc != blank -%}
          <p class="ldc-hero-desc">{{ section.settings.hero_desc | escape }}</p>
        {%- endif -%}
        {%- if section.settings.hero_cta_label != blank -%}
          <a href="{{ section.settings.hero_cta_link | default: '#ldc-gallery-grid' }}" class="ldc-hero-btn">
            {{ section.settings.hero_cta_label | escape }}
          </a>
        {%- endif -%}
      </div>
    </div>

    <!-- 2. PROMOTIONAL FEATURE BANNERS (scattered into the product grid as bento tiles via JS) -->
    <template id="ldc-promo-tiles-template">
      {%- liquid
        assign p1_img = section.settings.promo1_image
        if p1_img == blank
          assign p1_url = 'https://cdn.shopify.com/s/files/1/0665/5036/6274/files/WhatsApp_Image_2026-07-21_at_9.35.24_PM.jpg?v=1784652068'
        else
          assign p1_url = p1_img | image_url: width: 1200
        endif
        assign p2_img = section.settings.promo2_image
        if p2_img == blank
          assign p2_url = 'https://cdn.shopify.com/s/files/1/0665/5036/6274/files/WhatsApp_Image_2026-07-17_at_10.31.08_PM_3.jpg?v=1784350056'
        else
          assign p2_url = p2_img | image_url: width: 1200
        endif
      -%}
      <a href="{{ section.settings.promo1_link | default: '#ldc-gallery-grid' }}" class="ldc-promo-banner ldc-bento-tile" style="background-image: url('{{ p1_url }}');">
        <div class="ldc-promo-overlay"></div>
        <div class="ldc-promo-content">
          <h3 class="ldc-promo-title">{{ section.settings.promo1_title | escape }}</h3>
          <p class="ldc-promo-desc">{{ section.settings.promo1_desc | escape }}</p>
        </div>
      </a>
      <a href="{{ section.settings.promo2_link | default: '#ldc-gallery-grid' }}" class="ldc-promo-banner ldc-bento-tile" style="background-image: url('{{ p2_url }}');">
        <div class="ldc-promo-overlay"></div>
        <div class="ldc-promo-content">
          <h3 class="ldc-promo-title">{{ section.settings.promo2_title | escape }}</h3>
          <p class="ldc-promo-desc">{{ section.settings.promo2_desc | escape }}</p>
        </div>
      </a>
    </template>

    <!-- 3. PRODUCT CATALOGUE HEADER -->
    <div class="ldc-catalog-section-header">
      <h2 class="ldc-catalog-section-title">{{ section.settings.catalog_heading | default: 'All Collection' | escape }}</h2>

      <!-- Price & Sort Filters -->
      <div class="ldc-filter-bar">

        <div class="ldc-sort-wrap">
          <label for="ldc-sort-select" class="ldc-sort-label">Sort by</label>
          <div class="ldc-sort-select-wrap">
            <select id="ldc-sort-select" class="ldc-sort-select" onchange="ldcSortGallery(this.value)">
              <option value="featured">Featured</option>
              <option value="price-asc">Price: Low to High</option>
              <option value="price-desc">Price: High to Low</option>
              <option value="name-asc">Name: A &ndash; Z</option>
            </select>
          </div>
        </div>
      </div>
    </div>

    <div class="ldc-gallery-grid" id="ldc-gallery-grid">
      <!-- Generated via JS -->
    </div>
  </div>

  <!-- VIEW 2: IMMERSIVE 5-STEP CUSTOMIZER SCREEN -->
  <div id="ldc-wizard-view" class="ldc-wizard-container" style="display: none;">
    <!-- TOP PROGRESS BAR & NAVIGATION -->
    <div class="ldc-wiz-header">
      <button class="ldc-wiz-back-arrow-btn" onclick="ldcPrevStep()">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M19 12H5M12 19l-7-7 7-7"/>
        </svg>
        <span>back</span>
      </button>
      <div class="ldc-wiz-progress-wrap">
        <div class="ldc-wiz-progress-bar" id="ldc-progress-bar" style="width: 0%;"></div>
        <div class="ldc-wiz-progress-labels">
          <span class="ldc-wiz-progress-step" id="ldc-wiz-step-num">Step 1 of 5</span>
          <span class="ldc-wiz-progress-name" id="ldc-wiz-step-name">Choose Lens Type</span>
        </div>
      </div>
      <button class="ldc-wiz-close-btn" onclick="ldcExitCustomizer()">
        <span>exit</span>
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
          <path d="M18 6L6 18M6 6l12 12"/>
        </svg>
      </button>
    </div>

    <div class="ldc-wiz-layout">
      <!-- LEFT COLUMN: LIVE PREVIEW SHOWCASE -->
      <div class="ldc-wiz-left">
        <div class="ldc-preview-card">
          <span class="ldc-preview-kicker" id="ldc-preview-model-name">Park</span>
          <h2 class="ldc-preview-title" id="ldc-preview-frame-color">Emerald Acetate</h2>
          
          <div class="ldc-preview-image-container">
            <img id="ldc-preview-frame-img" src="" alt="Custom Eyewear Frame" class="ldc-preview-main-img">
            <!-- Dynamic Lens Color Overlay for tint simulation -->
            <div id="ldc-preview-lens-overlay" class="ldc-preview-lens-overlay"></div>
          </div>

          <div class="ldc-preview-specs">
            <span>Handcrafted Bio-Acetate</span>
            <span>&bull;</span>
            <span>German Steel Hinges</span>
            <span>&bull;</span>
            <span>100% UVA/UVB Protection</span>
          </div>
        </div>
      </div>

      <!-- RIGHT COLUMN: STEP CONTROLS -->
      <div class="ldc-wiz-right">
        <div class="ldc-step-panels">
          
          <!-- STEP 1: CHOOSE LENS TYPE -->
          <div id="ldc-step-panel-1" class="ldc-step-panel active">
            <span class="ldc-step-kicker">Step 1 &mdash; Specification</span>
            <h3 class="ldc-step-title">Choose Your Lens Type</h3>
            <p class="ldc-step-desc">Select the lens technology and prescription type for your daily routine.</p>
            
            <div class="ldc-options-vertical" id="ldc-lens-type-options">
              <!-- Populated dynamically via JS -->
            </div>
          </div>

          <!-- STEP 2: PRESCRIPTION UPLOAD -->
          <div id="ldc-step-panel-2" class="ldc-step-panel">
            <span class="ldc-step-kicker">Step 2 &mdash; Medical Details</span>
            <h3 class="ldc-step-title">Add Your Prescription</h3>
            <p class="ldc-step-desc">Please upload your optical prescription. We accept high-resolution JPG, PNG, or PDF formats.</p>
            
            <div class="ldc-upload-container">
              <div class="ldc-upload-zone" id="ldc-upload-zone">
                <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1" class="ldc-upload-icon">
                  <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4M17 8l-5-5-5 5M12 3v12"/>
                </svg>
                <div class="ldc-upload-text-main">Click or Drag to Upload Prescription</div>
                <div class="ldc-upload-text-sub">Support files: .jpg, .png, .pdf (Max 10MB)</div>
                <input type="file" id="ldc-rx-file-input" style="display: none;" accept=".jpg,.jpeg,.png,.pdf">
              </div>

              <!-- Upload Success State -->
              <div class="ldc-upload-success" id="ldc-upload-success" style="display: none;">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="ldc-success-icon">
                  <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/>
                  <polyline points="22 4 12 14.01 9 11.01"/>
                </svg>
                <div class="ldc-upload-success-info">
                  <div class="ldc-success-title">Prescription Uploaded Successfully</div>
                  <div class="ldc-success-filename" id="ldc-uploaded-filename">prescription_2026.pdf</div>
                </div>
                <button type="button" class="ldc-upload-replace-btn" onclick="ldcTriggerUpload()">Replace File</button>
              </div>

              <!-- Error State -->
              <div class="ldc-upload-error" id="ldc-upload-error" style="display: none;">
                Please upload a valid JPG, PNG, or PDF file.
              </div>
            </div>
          </div>

          <!-- STEP 3: LENS COLOUR SELECTION -->
          <div id="ldc-step-panel-3" class="ldc-step-panel">
            <span class="ldc-step-kicker">Step 3 &mdash; Aesthetic Tints</span>
            <h3 class="ldc-step-title">Select Lens Color</h3>
            <p class="ldc-step-desc">Choose from our signature hues, crafted for light performance and rich aesthetics.</p>

            <div class="ldc-swatch-section">
              <h4 class="ldc-swatch-section-title">Solid Tints</h4>
              <div class="ldc-swatch-grid" id="ldc-solid-swatches">
                <!-- Populated via JS -->
              </div>
            </div>

            <div class="ldc-swatch-section" style="margin-top: 30px;">
              <h4 class="ldc-swatch-section-title">Gradient Tints</h4>
              <div class="ldc-swatch-grid" id="ldc-gradient-swatches">
                <!-- Populated via JS -->
              </div>
            </div>
          </div>

          <!-- STEP 4: REVIEW & ADD TO CART -->
          <div id="ldc-step-panel-4" class="ldc-step-panel">
            <span class="ldc-step-kicker">Final Step &mdash; Summary</span>
            <h3 class="ldc-step-title">Review Your Customization</h3>
            <p class="ldc-step-desc">Verify your custom choices before adding them to the cart.</p>

            <div class="ldc-summary-card">
              <div class="ldc-summary-row">
                <span class="ldc-summary-label">Frame Model</span>
                <span class="ldc-summary-val" id="ldc-sum-model">Park</span>
              </div>
              <div class="ldc-summary-row">
                <span class="ldc-summary-label">Frame Finish</span>
                <span class="ldc-summary-val" id="ldc-sum-frame-color">Emerald</span>
              </div>
              <div class="ldc-summary-row">
                <span class="ldc-summary-label">Lens Technology</span>
                <span class="ldc-summary-val" id="ldc-sum-lens-type">Signature Tints</span>
              </div>
              <div class="ldc-summary-row id-lens-color-row">
                <span class="ldc-summary-label">Lens Color / Tint</span>
                <span class="ldc-summary-val" id="ldc-sum-lens-color">Azure Blue (Solid)</span>
              </div>
              <div class="ldc-summary-row id-rx-uploaded-row">
                <span class="ldc-summary-label">Prescription Uploaded</span>
                <span class="ldc-summary-val" id="ldc-sum-rx-uploaded">Yes</span>
              </div>
              
              <div class="ldc-summary-divider"></div>

              <div class="ldc-summary-row">
                <span class="ldc-summary-label">Base Frame Price</span>
                <span class="ldc-summary-val" id="ldc-sum-frame-price">AED 650</span>
              </div>
              <div class="ldc-summary-row">
                <span class="ldc-summary-label">Lens Upgrade</span>
                <span class="ldc-summary-val" id="ldc-sum-lens-price">+ AED 150</span>
              </div>
              <div class="ldc-summary-row ldc-summary-total">
                <span class="ldc-summary-label">Total Investment</span>
                <span class="ldc-summary-val" id="ldc-sum-total-price">AED 800</span>
              </div>
            </div>
          </div>

        </div>

        <!-- FOOTER NAV BUTTONS -->
        <div class="ldc-wiz-footer">
          <div class="ldc-wiz-price-display">
            <span class="ldc-wiz-price-label">total</span>
            <span class="ldc-wiz-price-amount" id="ldc-wiz-price-amount">AED 800</span>
          </div>
          
          <div class="ldc-wiz-actions">
            <!-- Next Step / Add to Cart trigger -->
            <button type="button" class="ldc-wiz-btn-primary" id="ldc-wiz-next-btn" onclick="ldcNextStep()">
              <span>continue</span>
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M5 12h14M12 5l7 7-7 7"/>
              </svg>
            </button>
            <button type="button" class="ldc-wiz-btn-primary" id="ldc-wiz-cart-btn" style="display: none;" onclick="ldcAddToCart()">
              <span>add to cart</span>
            </button>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<style>
  /* The hero breaks out to 100vw, which counts the vertical scrollbar's width —
     on desktop that overhangs the viewport by ~15px and produces a horizontal
     scrollbar. Clip it at the page level; `clip` rather than `hidden` so it does
     not turn body into a scroll container and kill position: sticky. */
  body:has(.ldc-customizer-section) {
    overflow-x: clip;
  }

  /* ------------------- CORE DESIGN VARIABLES ------------------- */
  .ldc-customizer-section {
    font-family: 'Canela', serif;
    background-color: var(--ldc-white, #FAFAF7);
    color: var(--ldc-burgundy, #5A1F26);
    padding: 0 20px 24px;
    min-height: 90vh;
    box-sizing: border-box;
  }
  @media (min-width: 990px) {
    .ldc-customizer-section {
      padding: 0 6px 24px;
    }
  }

  .ldc-hero-desc,
  .ldc-promo-desc,
  .ldc-step-desc,
  .ldc-opt-desc {
    font-family: var(--ldc-font-script) !important;
    font-style: italic !important;
  }
  .ldc-customizer-section * {
    box-sizing: border-box;
  }

  /* ------------------- VIEW 1: GALLERY VIEW ------------------- */
  .ldc-gallery-container {
    max-width: 1300px;
    margin: 0 auto;
  }
  .ldc-gallery-hero {
    position: relative;
    width: 100vw;
    margin-left: calc(50% - 50vw);
    margin-right: calc(50% - 50vw);
    height: 640px;
    margin-top: calc(var(--header-height, 60px) * -1);
    padding: calc(var(--header-height, 60px) + 20px) 20px 20px;
    border-radius: 0;
    margin-bottom: 60px;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    box-sizing: border-box;
    overflow: hidden;
    z-index: 1;
  }

  /* Separate layer so it can be translated for parallax without moving the
     overlay or the copy. Oversized top/bottom to hide the edges as it drifts. */
  .ldc-gallery-hero__bg {
    position: absolute;
    top: -35%;
    left: 0;
    width: 100%;
    height: 170%;
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
    z-index: 0;
    will-change: transform;
    pointer-events: none;
  }

  /* Same treatment as the homepage hero: a soft body gradient that deepens
     toward the bottom, plus a stronger top band so the transparent header's
     white nav stays legible against the image. */
  .ldc-hero-overlay {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: rgba(0, 0, 0, 0.45);
    z-index: 1;
    pointer-events: none;
  }

  .ldc-hero-overlay::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 220px;
    background: linear-gradient(
      to bottom,
      rgba(0, 0, 0, 0.55) 0%,
      rgba(0, 0, 0, 0.28) 55%,
      rgba(0, 0, 0, 0) 100%
    );
    pointer-events: none;
  }

  @media (max-width: 767px) {
    .ldc-hero-overlay::before {
      height: 140px;
    }
  }

  .ldc-hero-content {
    position: relative;
    z-index: 2;
    max-width: 600px;
    color: #fff;
  }
  .ldc-hero-subtitle {
    font-family: 'Canela', sans-serif;
    font-size: 11px;
    letter-spacing: 0.25em;
    text-transform: uppercase;
    color: #e5c158;
    display: block;
    margin-bottom: 12px;
  }
  .ldc-hero-title {
    font-family: 'Canela', sans-serif;
    font-size: clamp(36px, 5vw, 54px);
    margin: 0 0 16px 0;
    line-height: 1.1;
    font-weight: normal;
    text-transform: uppercase;
    color: #fff;
  }
  .ldc-hero-desc {
    font-size: 16px;
    line-height: 1.6;
    margin: 0 0 30px 0;
    color: rgba(255, 255, 255, 0.9);
  }
  .ldc-hero-btn {
    display: inline-block;
    padding: 12px 35px;
    border: 1px solid #fff;
    color: #fff;
    font-family: 'Canela', sans-serif;
    font-size: 12px;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    text-decoration: none;
    transition: all 0.3s ease;
    background: transparent;
  }
  .ldc-hero-btn:hover {
    background: #fff;
    color: var(--ldc-burgundy);
  }

  /* 2. PROMOTIONAL FEATURE BANNERS — scattered as bento tiles inside the product grid */
  .ldc-promo-banner {
    position: relative;
    width: 100%;
    height: 100%;
    background-size: cover;
    background-position: center;
    display: flex;
    align-items: flex-end;
    padding: 20px;
    text-decoration: none;
    overflow: hidden;
  }
  .ldc-promo-overlay {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: linear-gradient(to top, rgba(0, 0, 0, 0.6) 0%, rgba(0, 0, 0, 0.1) 100%);
    z-index: 1;
    transition: background 0.3s ease;
  }
  .ldc-promo-banner:hover .ldc-promo-overlay {
    background: linear-gradient(to top, rgba(0, 0, 0, 0.7) 0%, rgba(0, 0, 0, 0.2) 100%);
  }
  .ldc-promo-content {
    position: relative;
    z-index: 2;
    color: #fff;
    text-align: left;
  }
  .ldc-promo-title {
    font-family: 'Canela', sans-serif;
    font-size: 20px;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    margin: 0 0 8px 0;
    font-weight: normal;
    color: #fff;
  }
  .ldc-promo-desc {
    font-size: 14px;
    line-height: 1.4;
    margin: 0;
    color: rgba(255, 255, 255, 0.85);
  }

  /* 3. CATALOGUE HEADER */
  .ldc-catalog-section-header {
    text-align: center;
    max-width: 1300px;
    margin: 0 auto 40px;
  }
  .ldc-catalog-section-title {
    font-family: 'Canela', sans-serif;
    font-size: clamp(28px, 4vw, 36px);
    text-transform: uppercase;
    letter-spacing: 0.15em;
    margin: 0 0 28px 0;
    font-weight: normal;
    color: var(--ldc-burgundy);
  }

  /* PRICE & SORT FILTER BAR */
  .ldc-filter-bar {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 18px;
    padding-top: 0;
    border-top: none;
  }

  .ldc-price-chips {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 10px;
  }

  .ldc-chip {
    background: transparent;
    border: 1px solid rgba(90, 31, 38, 0.2);
    border-radius: 20px;
    cursor: pointer;
    font-family: 'Canela', serif;
    font-size: 12px;
    letter-spacing: 0.02em;
    color: var(--ldc-burgundy);
    padding: 7px 16px;
    white-space: nowrap;
    transition: all 0.2s ease;
  }

  .ldc-chip:hover {
    border-color: var(--ldc-burgundy);
  }

  .ldc-chip.active {
    background: var(--ldc-burgundy);
    border-color: var(--ldc-burgundy);
    color: var(--ldc-white);
  }

  .ldc-sort-wrap {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .ldc-sort-label {
    font-family: 'Canela', sans-serif;
    font-size: 11px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #999;
    white-space: nowrap;
  }

  .ldc-sort-select-wrap {
    position: relative;
    display: inline-flex;
    align-items: center;
  }

  .ldc-sort-select-wrap::after {
    content: '';
    position: absolute;
    right: 14px;
    top: 50%;
    width: 7px;
    height: 7px;
    border-right: 1.5px solid var(--ldc-burgundy);
    border-bottom: 1.5px solid var(--ldc-burgundy);
    transform: translateY(-65%) rotate(45deg);
    pointer-events: none;
  }

  .ldc-sort-select {
    appearance: none;
    -webkit-appearance: none;
    background: #fff;
    border: 1px solid rgba(90, 31, 38, 0.2);
    border-radius: 20px;
    padding: 7px 34px 7px 16px;
    font-family: 'Canela', serif;
    font-size: 12px;
    letter-spacing: 0.02em;
    color: var(--ldc-burgundy);
    cursor: pointer;
    transition: border-color 0.2s ease;
  }

  .ldc-sort-select:hover,
  .ldc-sort-select:focus {
    border-color: var(--ldc-burgundy);
    outline: none;
  }

  @media (min-width: 768px) {
    .ldc-filter-bar {
      flex-direction: row;
      align-items: center;
      justify-content: flex-end;
      flex-wrap: wrap;
      text-align: left;
    }

    .ldc-price-chips {
      justify-content: flex-start;
    }
  }

  /* ---- MOBILE STOREFRONT LAYOUT -------------------------------------------
     Centred, wrapping filters read as a landing page rather than a shop. On
     phones the chips become a single edge-to-edge scroll rail and the sort
     control sits on its own row, which is the pattern shoppers expect. */
  @media (max-width: 767px) {
    .ldc-catalog-section-header {
      text-align: left;
      margin-bottom: 18px;
    }

