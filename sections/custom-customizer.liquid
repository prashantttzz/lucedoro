    }

    const lensTypes = [
      { id: 'sig-tints', name: 'Signature Tints', desc: 'Custom colored non-prescription lenses.', upgrade: 150 },
      { id: 'sig-tints-rx', name: 'Signature Tints + Prescription', desc: 'Custom colored prescription lenses.', upgrade: 180 },
      { id: 'digital-blue', name: 'Digital Blue', desc: 'Blue-light filtering lenses for everyday screen use.', upgrade: 200 },
      { id: 'optical-clear', name: 'Optical Clear', desc: 'Clear prescription lenses.', upgrade: 180 }
    ];

    const solidColors = [
      { name: 'Burnt Citrus', value: 'burnt-citrus.png', image: "{{ 'burnt-citrus.png' | asset_url }}", opacity: 0.5 },
      { name: 'Buttercup', value: 'buttercup.png', image: "{{ 'buttercup.png' | asset_url }}", opacity: 0.3 },
      { name: 'Evergreen', value: 'evergreen.png', image: "{{ 'evergreen.png' | asset_url }}", opacity: 0.4 },
