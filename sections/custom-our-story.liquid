<div class="cos-story-section" id="ldc-our-story">
  <div class="cos-story-container">
    <div class="cos-story-split">
      <div class="cos-story-left ldc-animate">
        <h2 class="cos-story-heading">{{ section.settings.heading | default: 'Our Story' }}</h2>
        <div class="cos-story-text">
          {{ section.settings.text }}
        </div>
      </div>
      <div class="cos-story-right ldc-animate">
        <div class="cos-story-img-wrapper">
          {% if section.settings.image != blank %}
            {{ section.settings.image | image_url: width: 1200 | image_tag: class: 'cos-story-img', loading: 'lazy' }}
          {% else %}
            <img
              src="https://cdn.shopify.com/s/files/1/0665/5036/6274/files/WhatsApp_Image_2026-07-21_at_9.35.24_PM.jpg?v=1784652068"
              alt="Our Story"
              class="cos-story-img"
              loading="lazy"
              width="1200"
              height="1200"
            >
          {% endif %}
        </div>
      </div>
    </div>
  </div>
</div>

<style>
  .cos-story-section {
    padding: 80px 5%;
    background-color: #fafaf7;
  }

  .cos-story-container {
    max-width: 1200px;
    margin: 0 auto;
  }

  .cos-story-split {
    display: grid;
    grid-template-columns: 1fr;
    gap: 40px;
    align-items: center;
  }

  @media (min-width: 990px) {
    .cos-story-split {
      grid-template-columns: 1fr 1fr;
      gap: 60px;
    }
  }

  .cos-story-left {
    max-width: 540px;
    margin: 0 auto;
  }

  @media (min-width: 990px) {
    .cos-story-left {
      margin: 0;
      padding-right: 40px;
    }
  }

  .cos-story-heading {
    font-family: 'Canela', sans-serif !important;
    font-size: clamp(36px, 4vw, 48px);
    color: #5a1f26;
    margin: 0 0 30px 0;
    font-weight: normal;
    line-height: 1.1;
  }

  .cos-story-text {
    font-family: var(--ldc-font-script) !important;
    font-style: italic !important;
    font-weight: 400 !important;
    font-size: 15px;
    line-height: 1.65;
    color: #2b2b2b;
  }

  .cos-story-text p {
    margin-bottom: 20px;
  }
  .cos-story-text p:last-child {
    margin-bottom: 0;
  }

  .cos-story-right {
    width: 100%;
  }

  .cos-story-img-wrapper {
    position: relative;
    width: 100%;
    aspect-ratio: 4 / 5;
    overflow: hidden;
    border-radius: 16px;
    border: 1px solid rgba(198, 161, 91, 0.35);
    box-shadow: 0 20px 48px rgba(90, 31, 38, 0.12);
    transition: transform 0.4s ease, box-shadow 0.4s ease;
  }

  .cos-story-img-wrapper:hover {
    transform: translateY(-4px);
    box-shadow: 0 28px 56px rgba(90, 31, 38, 0.18);
  }

  .cos-story-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .cos-story-img-wrapper:hover .cos-story-img {
    transform: scale(1.03);
  }

  @media (max-width: 767px) {
    .cos-story-section {
      padding: 50px 20px;
    }
    .cos-story-split {
      display: flex;
      flex-direction: column-reverse;
      gap: 30px;
    }
  }
</style>

{% schema %}
{
  "name": "Custom Our Story",
  "tag": "section",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Right Image"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Our Story"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Story Text",
      "default": "<p>Luce D’Oro Club was created from a genuine appreciation for eyewear and the way a great pair of glasses can become part of who you are.</p><p>We started with a simple idea: to offer distinctive frames that people would genuinely want to wear. As the brand grew, so did our vision — introducing custom lens colours and new ways to make each pair more personal.</p><p>We’re still at the beginning of our story, continuously exploring new ideas, better craftsmanship, and what Luce D’Oro Club can become.</p><p>Welcome to the Club.</p>"
    }
  ],
  "presets": [
    {
      "name": "Custom Our Story"
    }
  ]
}
{% endschema %}
