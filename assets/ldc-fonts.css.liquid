@font-face {
  font-family: 'LDC';
  src: url('{{ "ldc-font.woff2" | asset_url }}') format('woff2');
  font-weight: 400;
  font-style: normal;
  font-display: swap;
}

h1, h2, h3, .hero__heading, .hero__heading * {
  font-family: 'LDC', serif !important;
}
/* Header store name (Luce D’Oro Club) */
.header__heading,
.header__heading a,
.header__heading span,
.header__heading-link {
  font-family: 'LDC', serif !important;
}
