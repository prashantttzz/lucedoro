@font-face {
  font-family: 'Canela';
  src: url('{{ "Canela-Regular-Trial.otf" | asset_url }}') format('opentype');
  font-weight: 400;
  font-style: normal;
  font-display: swap;
}

@font-face {
  font-family: 'Canela';
  src: url('{{ "Canela-Thin-Trial.otf" | asset_url }}') format('opentype');
  font-weight: 100;
  /* Thin */
  font-style: normal;
  font-display: swap;
}

/* In-page anchor targets (the HOME mega-menu links at blocks/_header-menu.liquid).
   The header is fixed and overlays the page, so an untreated anchor lands with
   the section's top edge underneath it. scroll-margin-top reserves that height
   at the jump point. */
html {
  scroll-behavior: smooth;
}

#ldc-hero,
#ldc-featured,
#ldc-the-look,
#ldc-our-story,
#custom-bento-grid {
  scroll-margin-top: var(--header-height, 60px);
}

@media (prefers-reduced-motion: reduce) {
  html {
    scroll-behavior: auto;
  }
}

:root {
  --font-body-family: 'Canela' !important;
  --font-body--family: 'Canela' !important;
  --font-paragraph--family: 'Canela' !important;
  --font-family: 'Canela' !important;
  /* Secondary/script roles belong to Playwrite (see assets/ldc-fonts.css.liquid).
     Canela stays the primary face for headings and body copy. */
  --font-subheading--family: var(--ldc-font-script) !important;
  --font-subheading--style: italic !important;
  --font-accent--family: var(--ldc-font-script) !important;
  --font-accent--style: italic !important;

  --font-heading-family: 'Canela' !important;
  --font-heading--family: 'Canela' !important;
  --font-h1--family: 'Canela' !important;
  --font-h2--family: 'Canela' !important;
  --font-h3--family: 'Canela' !important;
  --font-h4--family: 'Canela' !important;
  --font-h5--family: 'Canela' !important;
  --font-h6--family: 'Canela' !important;
  --font-paragraph--case: none !important;
  --font-h1--case: none !important;
  --font-h2--case: none !important;
  --font-h3--case: none !important;
  --font-h4--case: none !important;
  --font-h5--case: none !important;
  --font-h6--case: none !important;
  --button-text-case-primary: none !important;
  --button-text-case-secondary: none !important;

  /* Global Color Palette */
  --ldc-green: #2E3B33;
  --ldc-burgundy: #5A1F26;
  --ldc-beige: #E9E2D6;
  --ldc-gold: #C6A15B;
  --ldc-white: #FAFAF7;
  --ldc-black: #111111;

  /* Shopify Core Overrides */
  --color-base-background-1: #FAFAF7 !important;
  /* Off-White background */
  --color-base-background-2: #E9E2D6 !important;
  --color-base-text: #5A1F26 !important;
  /* Burgundy text */
  --color-base-solid-button-labels: #FAFAF7 !important;
  --color-base-outline-button-labels: #5A1F26 !important;
  --color-button: #5A1F26 !important;
  --color-button-text: #FAFAF7 !important;
  --color-foreground: #5A1F26 !important;
  /* Burgundy text */
  --color-background: #FAFAF7 !important;
  /* Off-White background */
}

body,
.gradient,
html {
  background-color: var(--ldc-white) !important;
  color: var(--ldc-burgundy) !important;
}

/* Global scheme overrides */
.color-scheme-1,
.color-scheme-2,
.color-scheme-3,
.color-scheme-4,
.color-scheme-5,
.color-scheme-6 {
  background-color: var(--ldc-white) !important;
  background: var(--ldc-white) !important;
  color: var(--ldc-burgundy) !important;
}

/* Product Section Exception: Uses secondary Off-White */
.section-main-product,
.section-main-product .color-scheme-1,
.section-main-product .color-scheme-2,
.product-section,
.product {
  background-color: var(--ldc-white) !important;
  background: var(--ldc-white) !important;
}

body,
p,
li,
a,
button,
input,
textarea,
select,
label {
  font-family: 'Canela' !important;
}

body,
h1,
h2,
h3,
h4,
h5,
h6,
p,
a,
span,
li,
button,
input,
textarea,
select,
label,
summary,
small,
strong,
em,
legend,
blockquote,
figcaption,
td,
th,
.button,
[class*="title"],
[class*="heading"],
[class*="label"],
[class*="caption"],
[class*="link"],
[class*="menu"] {
  text-transform: none !important;
}

/* Headings + Hero + Header + Footer + Product Title */
h1,
h2,
h3,
h4,
h5,
h6,
.hero__heading,
.hero__heading *,
.hero__subheading,
.parallax-hero-heading,
.parallax-hero-subheading,
.product__title,
.product__title h1,
.product-title,
.footer-block__heading,
.header__heading-link,
.menu-list__link-title,
.header__heading,
.header__heading a,
.header__heading span,
.header__heading-logo,
.header__heading-logo-wrapper {
  font-family: 'Canela' !important;
  font-weight: normal !important;
  text-transform: none !important;
  letter-spacing: normal !important;
  line-height: 1.15 !important;
}

/* Explicit size scale up for navigation links */
.menu-list__link-title {
  font-family: 'Canela' !important;
  font-size: 0.95rem !important;
  font-weight: 500 !important;
  line-height: 1.2 !important;
  letter-spacing: 0.12em !important;
  text-transform: uppercase !important;
}

.menu-list__list-item {
  padding-inline: 18px !important;
}

/* Header Padding Override */
.header,
.header__columns,
.header-wrapper {
  --header-padding: 2px !important;
  --padding-block-start: 2px !important;
  --padding-block-end: 2px !important;
  padding: 2px !important;
}

/* Global Scroll Reveal Animations */
.ldc-animate {
  opacity: 0;
  transform: translateY(40px);
  transition: opacity 0.8s cubic-bezier(0.16, 1, 0.3, 1), transform 0.8s cubic-bezier(0.16, 1, 0.3, 1);
  will-change: opacity, transform;
}

.ldc-animate.is-visible {
  opacity: 1;
  transform: translateY(0);
}

/* Lenis smooth scrolling compatibility */
html.lenis,
html.lenis body {
  height: auto;
}

.lenis.lenis-smooth {
  scroll-behavior: auto !important;
}

.lenis.lenis-smooth [data-lenis-prevent] {
  overscroll-behavior: contain;
}

.lenis.lenis-stopped {
  overflow: hidden;
}

.lenis.lenis-scrolling iframe {
  pointer-events: none;
}

/* Brand Color Definitions & Root Overrides */
:root {
  --color-forest: #2E3B33;
  --color-burgundy: #5A1F26;
  --color-beige: #E9E2D6;
  --color-gold: #C6A15B;
  --color-offwhite: #FAFAF7;
  --color-black: #111111;
}

/* Force body styling to match personality */
body {
  background-color: #FAFAF7 !important;
  color: #5A1F26 !important;
}

/* Custom Footer and Newsletter Styling to Match Reference */
.footer-section,
.footer,
[class*="footer-wrapper"],
.color-scheme-4 {
  background-color: #2E3B33 !important;
  /* Deep Forest Green background */
  color: #E9E2D6 !important;
  /* Warm Beige text */
}

/* Style footer headings to be Canela script/italic style */
.footer-content h4,
.footer-content .h4,
.footer-content [class*="heading"] {
  font-family: 'Canela' !important;
  font-style: normal !important;
  text-transform: none !important;
  color: #E9E2D6 !important;
  /* Warm Beige */
  font-weight: normal !important;
  font-size: 22px !important;
  letter-spacing: normal !important;
  line-height: 1.15 !important;
  margin-bottom: 20px !important;
}

/* Style footer links */
.footer-content a,
.footer-content p,
.footer-content span {
  font-family: 'Canela', serif !important;
  color: #FAFAF7 !important;
  /* Off White */
}

.footer-content a {
  text-transform: uppercase !important;
  font-size: 11px !important;
  letter-spacing: 0.15em !important;
  transition: color 0.3s ease;
}

.footer-content a:hover {
  color: #C6A15B !important;
  /* Gold hover */
}

/* Vintage circular seal layout for footer logo */
.footer .header__heading-logo,
.footer img[class*="logo"] {
  padding: 10px;
  border: 1px solid #C6A15B;
  /* Gold border frame */
  border-radius: 50%;
  background-color: transparent !important;
  max-width: 90px !important;
  height: auto !important;
}

/* Footer newsletter inputs styling (Underline inputs) */
.footer-content input[type="email"],
.footer-content input[type="text"] {
  background-color: transparent !important;
  border: none !important;
  border-bottom: 1px solid #E9E2D6 !important;
  border-radius: 0 !important;
  color: #FAFAF7 !important;
  padding: 12px 0 !important;
  font-family: 'Canela', serif !important;
  font-size: 12px !important;
  letter-spacing: 0.1em !important;
  text-transform: uppercase !important;
  width: 100% !important;
  box-shadow: none !important;
}

.footer-content input[type="email"]::placeholder,
.footer-content input[type="text"]::placeholder {
  color: rgba(233, 226, 214, 0.5) !important;
}

.footer-content input[type="email"]:focus,
.footer-content input[type="text"]:focus {
  border-bottom: 1px solid #C6A15B !important;
  /* Gold bottom border on focus */
}

/* Styling the newsletter submit button in footer */
.footer-content button[type="submit"],
.footer-content .newsletter-form__button,
.footer-content input[type="submit"] {
  background-color: #FAFAF7 !important;
  color: #2E3B33 !important;
  border: 1px solid #FAFAF7 !important;
  font-family: 'Canela', serif !important;
  text-transform: uppercase !important;
  font-size: 11px !important;
  letter-spacing: 0.15em !important;
  font-weight: 600 !important;
  padding: 10px 24px !important;
  cursor: pointer;
  transition: all 0.3s ease !important;
  margin-top: 15px !important;
  border-radius: 0 !important;
}

.footer-content button[type="submit"]:hover,
.footer-content .newsletter-form__button:hover {
  background-color: transparent !important;
  color: #FAFAF7 !important;
  border-color: #FAFAF7 !important;
}

/* Mega Menu and Header Retro Overrides */
#header-component {
  background-color: transparent !important;
  transition: background-color 0.28s cubic-bezier(0.22, 1, 0.36, 1);
  will-change: background-color;
}

#header-component .header__row,
#header-component .header__columns,
#header-component .header-menu,
#header-component .header-menu__inner,
#header-component .menu-list,
#header-component .menu-list__list-item,
#header-component .header__inline-menu,
/* The drawer is inside #header-component and carries a color-scheme class, so it
   matches this catch-all. It owns its background image (snippets/header-drawer.liquid)
   and must be excluded, or the shorthand below wipes it. */
#header-component [class*="color-scheme-"]:not(.menu-list__submenu-inner):not(.mega-menu):not(.menu-drawer):not(.menu-drawer *) {
  background-color: transparent !important;
  background: transparent !important;
}

/* Header stays transparent in every state. On hover the backdrop image painted by
   .header__row--top::before (sections/header.liquid) spans the strip and the open
   panel as one surface — an opaque colour here would cut it into a separate bar. */
#header-component:has(.menu-list__link[aria-haspopup]:is(:hover, [aria-expanded='true'])),
#header-component:has(.menu-list__submenu:hover),
#header-component:has([aria-expanded='true']) {
  background-color: transparent !important;
  color: var(--ldc-white) !important;
}

#header-component:has(.menu-list__link[aria-haspopup]:is(:hover, [aria-expanded='true'])) .header__row,
#header-component:has(.menu-list__link[aria-haspopup]:is(:hover, [aria-expanded='true'])) .header__columns,
#header-component:has(.menu-list__link[aria-haspopup]:is(:hover, [aria-expanded='true'])) .header-menu,
#header-component:has(.menu-list__link[aria-haspopup]:is(:hover, [aria-expanded='true'])) .header-menu__inner,
#header-component:has([aria-expanded='true']) .header__row,
#header-component:has([aria-expanded='true']) .header__columns,
#header-component:has([aria-expanded='true']) .header-menu,
#header-component:has([aria-expanded='true']) .header-menu__inner {
  background-color: transparent !important;
}

/* Default colors for transparent header */
.header a,
.header button,
.header span,
.header__heading-link {
  color: var(--ldc-white) !important;
  transition: color 0.28s cubic-bezier(0.22, 1, 0.36, 1);
}

.header__icon,
.header__icon svg,
.header__icon svg path {
  color: var(--ldc-white) !important;
  stroke: var(--ldc-white) !important;
  fill: none !important;
  /* Force transparent fill for outline icons */
  transition: stroke 0.28s cubic-bezier(0.22, 1, 0.36, 1), color 0.28s cubic-bezier(0.22, 1, 0.36, 1);
}

/* Force image logo to be white (handles black PNGs) */
.header-logo__image {
  filter: brightness(0) invert(1) !important;
}

/* On hover (when header is green), turn text and icons off-white */
#header-component:has([aria-expanded='true']) .header a,
#header-component:has([aria-expanded='true']) .header button,
#header-component:has([aria-expanded='true']) .header span,
#header-component:has([aria-expanded='true']) .header__heading-link,
#header-component:has(.menu-list__link[aria-haspopup]:is(:hover, [aria-expanded='true'])) .header a,
#header-component:has(.menu-list__link[aria-haspopup]:is(:hover, [aria-expanded='true'])) .header button,
#header-component:has(.menu-list__link[aria-haspopup]:is(:hover, [aria-expanded='true'])) .header span,
#header-component:has(.menu-list__link[aria-haspopup]:is(:hover, [aria-expanded='true'])) .header__heading-link {
  color: var(--ldc-white) !important;
}

#header-component:has([aria-expanded='true']) .header__icon,
#header-component:has([aria-expanded='true']) .header__icon svg,
#header-component:has([aria-expanded='true']) .header__icon svg path,
#header-component:has(.menu-list__link[aria-haspopup]:is(:hover, [aria-expanded='true'])) .header__icon,
#header-component:has(.menu-list__link[aria-haspopup]:is(:hover, [aria-expanded='true'])) .header__icon svg,
#header-component:has(.menu-list__link[aria-haspopup]:is(:hover, [aria-expanded='true'])) .header__icon svg path {
  color: var(--ldc-white) !important;
  stroke: var(--ldc-white) !important;
}

/* Mega Menu Dropdown Panel styling.
   The backdrop image is painted once by #header-component .header__row--top::before
   (see sections/header.liquid) so the header strip and the panel are a single
   continuous surface. These layers stay transparent — giving them their own
   `cover` image would render a second, misaligned copy and produce a visible seam. */
.menu-list__submenu-inner,
.mega-menu {
  background: transparent !important;
  color: #FAFAF7 !important;
  border: none !important;
}

.menu-list__submenu {
  background: transparent !important;
  clip-path: none !important;
  opacity: 0 !important;
  visibility: hidden !important;
  transform: translate3d(0, -4px, 0) !important;
  /* Matched to the backdrop's height transition so panel and surface move as one. */
  transition: opacity var(--submenu-animation-speed) var(--ease-out-cubic),
    transform var(--submenu-animation-speed) var(--ease-out-cubic),
    visibility var(--submenu-animation-speed) linear !important;
  margin-top: -1px;
  padding-top: 0 !important;
  padding-left: 0 !important;
  padding-right: 0 !important;
  box-shadow: none !important;
  will-change: opacity, transform;
  backface-visibility: hidden;
}

/* Force dropdown visibility on native CSS hover */
.menu-list__list-item:hover>.menu-list__submenu,
.menu-list__list-item:has([aria-expanded='true'])>.menu-list__submenu,
#header-component:has(.menu-list__link[aria-haspopup]:is(:hover, [aria-expanded='true'])) .menu-list__submenu,
#header-component:has(.menu-list__submenu:hover) .menu-list__submenu {
  visibility: visible !important;
  opacity: 1 !important;
  transform: translate3d(0, 0, 0) !important;
}

/* Force the inner content to actually become opaque (overriding theme JS opacity variables) */
.menu-list__list-item:hover,
.menu-list__list-item:has([aria-expanded='true']) {
  --submenu-content-opacity: 1 !important;
  --submenu-content-animation: opacity calc(var(--submenu-animation-speed) * 0.6) var(--ease-out-cubic)
    calc(var(--submenu-animation-speed) * 0.25) !important;
}


.mega-menu__grid {
  position: relative;
  z-index: 2;
  /* Content sits above noise overlay */
  min-height: 420px;
  transform: translateZ(0);
}

.menu-list__submenu-inner {
  padding-left: 0 !important;
  margin-left: 0 !important;
}

.mega-menu.section,
.mega-menu.section--full-width-margin {
  margin-left: 0 !important;
  padding-left: 0 !important;
}

/* Mega Menu Column Headings (Cursive Script style) */
.mega-menu__link--parent,
.mega-menu__link--parent span,
.mega-menu__link--parent * {
  font-family: 'Canela' !important;
  font-style: normal !important;
  text-transform: none !important;
  font-size: 22px !important;
  color: #E9E2D6 !important;
  /* Brand Warm Beige */
  font-weight: normal !important;
  letter-spacing: normal !important;
  line-height: 1.15 !important;
  margin-bottom: 12px !important;
}

/* Mega Menu Child Links */
.mega-menu__column ul li a.mega-menu__link,
.mega-menu__column ul li a.mega-menu__link span,
.mega-menu__column ul li a.mega-menu__link * {
  font-family: 'Canela', serif !important;
  font-size: 13px !important;
  letter-spacing: 0.04em !important;
  color: #FAFAF7 !important;
  /* Brand Off-White link text */
  font-weight: 500 !important;
  transition: color 0.3s ease;
}

.mega-menu__column ul li a.mega-menu__link:hover,
.mega-menu__column ul li a.mega-menu__link:hover * {
  color: #C6A15B !important;
  /* Gold on link hover */
}

/* Featured Image Box on the Right side (Styled as Polaroid frame) */
.mega-menu__content {
  display: flex !important;
  justify-content: flex-end !important;
  align-items: center !important;
}

.mega-menu__content--feature {
  align-self: stretch;
  min-width: 200px;
  max-width: 270px;
  flex: 0 1 22%;
}

.mega-menu__feature-panel {
  position: relative;
  display: block;
  width: 100%;
  min-height: 100%;
  overflow: hidden;
  text-decoration: none;
}

.mega-menu__feature-image {
  width: 100%;
  height: 100%;
  min-height: 300px;
  object-fit: cover;
  display: block;
  transform: translateZ(0);
}

.mega-menu__feature-overlay {
  position: absolute;
  inset: 0;
  background: linear-gradient(to top, rgba(0, 0, 0, 0.58) 0%, rgba(0, 0, 0, 0.08) 100%);
}

.mega-menu__feature-copy {
  position: absolute;
  inset-inline: 0;
  bottom: 0;
  z-index: 2;
  padding: 28px 24px;
  color: #FAFAF7;
}

.mega-menu__feature-kicker {
  margin: 0 0 8px;
  font-size: 11px;
  letter-spacing: 0.12em;
  color: rgba(250, 250, 247, 0.78);
}

.mega-menu__feature-title {
  margin: 0 0 8px;
  font-family: 'Canela' !important;
  font-size: clamp(28px, 2vw, 36px);
  font-weight: normal !important;
  line-height: 1.05 !important;
  color: #FAFAF7;
}

.mega-menu__feature-text {
  margin: 0;
  font-family: 'Canela' !important;
  font-size: 13px;
  line-height: 1.55;
  color: rgba(250, 250, 247, 0.92);
}

.mega-menu__content-list {
  display: block !important;
  width: 100% !important;
  max-width: 250px !important;
}

.mega-menu__content-list-item {
  background-color: #FAF5EB !important;
  /* Polaroid vintage cream backing */
  border: 1px solid #d3c4ad !important;
  padding: 10px 10px 38px 10px !important;
  /* Wider bottom margin for text label */
  box-shadow: 0 12px 30px rgba(0, 0, 0, 0.2) !important;
  transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1) !important;
  position: relative !important;
  border-radius: 2px !important;
}

.mega-menu__content-list-item:hover {
  transform: scale(1.03) rotate(1deg) !important;
}

/* Polaroid Image Wrapper and Inner Border */
.mega-menu__content-list-item .resource-card__image-wrapper,
.mega-menu__content-list-item img {
  border: 1px solid #d3c4ad !important;
  aspect-ratio: 1/1 !important;
  /* Force square format */
  object-fit: cover !important;
  filter: sepia(0.15) contrast(0.95) !important;
  border-radius: 0 !important;
}

/* Polaroid Text Labels */
.mega-menu__content-list-item .resource-card__info,
.mega-menu__content-list-item .resource-card__title,
.mega-menu__content-list-item [class*="title"],
.mega-menu__content-list-item [class*="heading"] {
  font-family: 'Canela', serif !important;
  text-transform: uppercase !important;
  font-size: 10px !important;
  letter-spacing: 0.12em !important;
  color: #8c765c !important;
  /* Muted brown */
  margin: 12px 0 0 0 !important;
  font-weight: 600 !important;
  text-align: center !important;
}

/* Polaroid "Shop Now" Link text */
.mega-menu__content-list-item::after {
  content: "Shop Now";
  position: absolute;
  bottom: 12px;
  left: 0;
  width: 100%;
  text-align: center;
  font-family: 'Canela', serif;
  font-size: 9px;
  text-decoration: underline;
  text-transform: uppercase;
  letter-spacing: 0.1em;
  color: #8c765c;
}

/* ==========================================================================
   Cart Drawer — brand styling (Luce D'Oro Club)
   ========================================================================== */

.cart-drawer__dialog {
  background-color: var(--ldc-white) !important;
  border-left: 1px solid rgba(90, 31, 38, 0.12) !important;
  box-shadow: -12px 0 40px rgba(90, 31, 38, 0.1) !important;
}

.cart-drawer__header,
.cart-drawer__content,
.cart-drawer__summary {
  background-color: var(--ldc-white) !important;
}

.cart-drawer__header {
  border-bottom: 1px solid rgba(90, 31, 38, 0.1) !important;
}

.cart-drawer__heading {
  font-family: 'Canela' !important;
  font-weight: normal !important;
  letter-spacing: normal !important;
  font-size: clamp(20px, 2.4vw, 26px) !important;
  color: var(--ldc-burgundy) !important;
}

.cart-drawer__close-button {
  color: var(--ldc-burgundy) !important;
  background-color: transparent !important;
  transition: opacity 0.2s ease;
}

.cart-drawer__close-button:hover {
  opacity: 0.6;
}

/* Cart count badge — burgundy everywhere (header icon and drawer heading). */
.cart-bubble__background {
  background-color: var(--ldc-burgundy) !important;
}

.cart-bubble__text,
.cart-bubble__text-count {
  color: var(--ldc-white) !important;
}

.cart-drawer__heading .cart-bubble__text {
  font-weight: 600 !important;
}

/* Line items */
.cart-drawer__items .cart-items__table-row {
  border-bottom: 1px solid rgba(90, 31, 38, 0.08) !important;
}

.cart-items__media-container {
  background-color: var(--ldc-beige, #E9E2D6);
  border-radius: 2px;
}

.cart-items__media-image {
  mix-blend-mode: multiply;
}

.cart-items__title {
  font-family: 'Canela' !important;
  font-weight: 600 !important;
  color: var(--ldc-burgundy) !important;
}

.cart-items__details {
  color: var(--ldc-burgundy) !important;
}

.cart-items__variants,
.cart-items__properties {
  text-transform: none !important;
}

.cart-items__price,
.cart-items__price * {
  font-family: 'Canela' !important;
  font-weight: 600 !important;
  color: var(--ldc-burgundy) !important;
}

.cart-items__price .compare-at-price {
  font-weight: 400 !important;
  color: var(--ldc-burgundy) !important;
}

/* Quantity selector */
.cart-items__quantity .quantity-selector {
  border-color: rgba(90, 31, 38, 0.18) !important;
  color: var(--ldc-burgundy) !important;
}

.cart-items__remove {
  color: var(--ldc-burgundy) !important;
}

.cart-items__remove:hover {
  color: var(--ldc-burgundy) !important;
}

/* Empty cart state */
.cart-drawer--empty .cart-drawer__heading {
  font-size: clamp(18px, 2vw, 22px) !important;
}

.cart-items__empty-button {
  background-color: var(--ldc-burgundy) !important;
  color: var(--ldc-white) !important;
  font-family: 'Canela' !important;
  font-size: 12px !important;
  font-weight: 600 !important;
  letter-spacing: normal !important;
  text-transform: none !important;
  border-radius: 2px !important;
  transition: background 0.3s ease, transform 0.2s ease;
}

.cart-items__empty-button:hover {
  background-color: #3d0c11 !important;
  transform: translateY(-1px);
}

/* Summary panel */
.cart-drawer__summary {
  border-top: 1px solid rgba(90, 31, 38, 0.1);
}

.cart__summary-totals:not(:has(.cart-actions)) {
  border-block-start: 1px solid rgba(90, 31, 38, 0.1) !important;
}

.cart__original-total-label,
.cart__total-label,
.cart-note__label,
.cart-discount__label {
  font-family: 'Canela' !important;
  font-size: 11px !important;
  letter-spacing: normal !important;
  text-transform: none !important;
  color: var(--ldc-burgundy) !important;
}

.cart__total-value {
  font-family: 'Canela' !important;
  font-weight: normal !important;
  color: var(--ldc-burgundy) !important;
}

.cart__original-total-value,
.cart__discount-value {
  font-family: 'Canela' !important;
  color: var(--ldc-burgundy) !important;
}

/* Cart note / discount accordions */
.cart-actions {
  border-color: rgba(90, 31, 38, 0.1) !important;
}

.cart-actions__divider {
  border-color: rgba(90, 31, 38, 0.1) !important;
}

.cart-note__instructions,
.cart-discount__input {
  background-color: var(--ldc-white) !important;
  border-color: rgba(90, 31, 38, 0.2) !important;
  color: var(--ldc-burgundy) !important;
  font-family: 'Canela' !important;
}

.cart-discount__button {
  color: var(--ldc-burgundy) !important;
}

.cart-discount__pill {
  background-color: var(--ldc-beige, #E9E2D6) !important;
  color: var(--ldc-burgundy) !important;
  text-transform: none !important;
}

/* Checkout button — matches the customizer's primary CTA styling */
.cart__checkout-button {
  background-color: var(--ldc-burgundy) !important;
  color: var(--ldc-white) !important;
  border: none !important;
  border-radius: 2px !important;
  font-family: 'Canela' !important;
  font-size: 12px !important;
  font-weight: 600 !important;
  letter-spacing: normal !important;
  text-transform: none !important;
  transition: background 0.3s ease, transform 0.2s ease;
}

.cart__checkout-button:hover {
  background-color: #3d0c11 !important;
  transform: translateY(-1px);
}

.cart__checkout-button:disabled {
  background-color: rgba(90, 31, 38, 0.3) !important;
  transform: none;
}
/* ===========================================================================
   ACCOUNT POPOVER / DRAWER
   The customer dialog behind the header user icon. Ships with the theme's
   default popover chrome (rounded corners, generic buttons); these rules bring
   it onto the brand: off-white ground, burgundy ink, Canela, square edges.
   =========================================================================== */

.account-popover__panel,
.account-drawer__dialog,
.account-actions {
  background-color: var(--ldc-white) !important;
  color: var(--ldc-burgundy) !important;
}

.account-popover__panel {
  border: 1px solid rgba(90, 31, 38, 0.16) !important;
  border-radius: 0 !important;
  box-shadow: 0 18px 44px rgba(90, 31, 38, 0.14) !important;
  min-width: 24rem !important;
}

.account-drawer__dialog {
  border: none !important;
  border-radius: 0 !important;
}

/* --- Header -------------------------------------------------------------
   A gold hairline under the greeting gives the panel a masthead rather than
   the theme's undifferentiated stack of rows. */
.account-actions__header {
  border-bottom: 1px solid rgba(90, 31, 38, 0.1);
  padding-bottom: 18px !important;
  position: relative;
}

.account-actions__header::after {
  content: '';
  position: absolute;
  left: var(--padding-xl, 20px);
  bottom: -1px;
  width: 42px;
  height: 1px;
  background-color: var(--ldc-gold);
}

.account-actions__title {
  font-family: 'Canela', serif !important;
  font-size: 22px !important;
  font-weight: normal !important;
  letter-spacing: 0.01em !important;
  text-transform: none !important;
  color: var(--ldc-burgundy) !important;
  line-height: 1.2 !important;
}

.account-actions__email {
  font-size: 12px !important;
  letter-spacing: 0.02em;
  color: rgba(90, 31, 38, 0.6) !important;
}

/* --- Icons ---------------------------------------------------------------
   The theme ships these as outline SVGs that inherit currentColor; force the
   stroke too, since some of the icon assets set it explicitly. */
.account-actions__icon svg,
.account-actions__icon svg path {
  color: currentColor !important;
  stroke: currentColor !important;
  fill: none !important;
}

.account-actions__link.button .account-actions__icon {
  color: var(--ldc-white) !important;
}

.account-actions__link.button-secondary .account-actions__icon {
  color: var(--ldc-burgundy) !important;
}

/* --- Drawer (mobile) -----------------------------------------------------
   The drawer is the same component presented full-width on small screens, so
   it needs the panel treatment plus a little more breathing room. */
.account-drawer__dialog .account-actions__header {
  padding-top: 26px !important;
}

.account-drawer__dialog .account-actions__title {
  font-size: 26px !important;
}

@media screen and (max-width: 479px) {
  .account-actions__list {
    grid-template-columns: 1fr !important;
  }

  .account-actions__title {
    font-size: 22px !important;
  }
}

/* --- Buttons ------------------------------------------------------------
   Small uppercase tracking matches the hero CTA and cart checkout button.

   shop-login-button is deliberately NOT styled here. It is a Shop-owned custom
   element that paints its own violet button; giving it a burgundy background
   only tints the strip around that button rather than restyling it. */
.account-actions__link.button {
  background-color: var(--ldc-burgundy) !important;
  color: var(--ldc-white) !important;
  border: 1px solid var(--ldc-burgundy) !important;
  border-radius: 2px !important;
  font-family: 'Canela', serif !important;
  font-size: 11px !important;
  letter-spacing: 0.14em !important;
  text-transform: uppercase !important;
  padding: 12px 18px !important;
  transition: background-color 0.3s ease, color 0.3s ease;
}

/* The panel's own padding is the only gutter these should have. Without an
   explicit border-box + 100% width the padding above pushes each button wider
   than the panel, so they overhang both edges. */
.account-actions__link.button,
.account-actions__link.button-secondary,
.account-actions__shop-login,
.account-actions__shop-login shop-login-button {
  box-sizing: border-box !important;
  display: block !important;
  width: 100% !important;
  max-width: 100% !important;
  margin-left: 0 !important;
  margin-right: 0 !important;
}

.account-actions__shop-login {
  background: none !important;
  overflow: hidden !important;
}

.account-actions__link.button:hover {
  background-color: #3d0c11 !important;
  border-color: #3d0c11 !important;
}

.account-actions__link.button-secondary {
  background-color: transparent !important;
  color: var(--ldc-burgundy) !important;
  border: 1px solid rgba(90, 31, 38, 0.25) !important;
  border-radius: 2px !important;
  font-family: 'Canela', serif !important;
  font-size: 11px !important;
  letter-spacing: 0.12em !important;
  text-transform: uppercase !important;
  padding: 12px 14px !important;
  transition: background-color 0.25s ease, border-color 0.25s ease;
}

.account-actions__link.button-secondary:hover {
  background-color: rgba(90, 31, 38, 0.05) !important;
  border-color: var(--ldc-burgundy) !important;
}

.account-actions__list {
  gap: 10px !important;
}

/* --- Drawer close button ------------------------------------------------ */
.account-drawer__close-button {
  color: var(--ldc-burgundy) !important;
}

.account-drawer__close-button:hover {
  opacity: 0.6;
}

/* --- Header account icon -------------------------------------------------
   The trigger itself, so the entry point reads as part of the same set as the
   cart and search icons rather than a default theme control. */
.header-actions__action--account .header__icon,
.header-actions__action--account .header__icon svg {
  transition: opacity 0.25s ease;
}

.header-actions__action--account:hover .header__icon {
  opacity: 0.7;
}
